#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_install:
	dh_install
	install -D -m 644 systemd/homelab-api.service debian/homelab-api/etc/systemd/system/homelab-api.service
	find migrations -type f -name '*.sql' -exec install -D -m 644 {} debian/homelab-api/usr/share/homelab-api/{} \;
