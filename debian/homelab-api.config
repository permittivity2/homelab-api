#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONFIG_FILE=/etc/homelab/api/config.yml

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$CONFIG_FILE" ]; then
    exit 0
fi

db_input high homelab-api/db/host || true
db_input high homelab-api/db/port || true
db_input high homelab-api/db/name || true
db_input high homelab-api/db/user || true
db_input high homelab-api/db/password || true
db_go

db_get homelab-api/db/host; HOST="$RET"
db_get homelab-api/db/port; PORT="$RET"
db_get homelab-api/db/name; DBNAME="$RET"
db_get homelab-api/db/user; DBUSER="$RET"
db_get homelab-api/db/password; DBPASS="$RET"

CONNECT_OK=0
if command -v psql >/dev/null 2>&1; then
    if PGPASSWORD="$DBPASS" PGCONNECT_TIMEOUT=5 psql -w -h "$HOST" -p "$PORT" -U "$DBUSER" -d "$DBNAME" -tAc "SELECT 1" </dev/null >/dev/null 2>&1; then
        CONNECT_OK=1
    fi
fi

if [ "$CONNECT_OK" -eq 0 ]; then
    db_input high homelab-api/db/connect_failed || true
    db_input high homelab-api/db/install_local || true
    db_go
fi

exit 0
