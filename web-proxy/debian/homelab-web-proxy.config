#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/nginx/sites-available/homelab-api.conf

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-web-proxy/roundcube_domain || true
db_input high homelab-web-proxy/roundcube_backend || true
db_input high homelab-web-proxy/api_domain || true
db_input high homelab-web-proxy/api_backend || true
db_input high homelab-web-proxy/drive_domain || true
db_input high homelab-web-proxy/drive_backend || true
db_input high homelab-web-proxy/sso_domain || true
db_input high homelab-web-proxy/sso_backend || true
db_input medium homelab-web-proxy/enable_certbot || true
db_go

exit 0
