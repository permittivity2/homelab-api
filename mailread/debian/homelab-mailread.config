#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/dovecot/conf.d/90-homelab-mailread-auth.conf

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-mailread/db_host || true
db_input high homelab-mailread/db_port || true
db_input high homelab-mailread/db_name || true
db_input high homelab-mailread/db_user || true
db_input high homelab-mailread/db_password || true
db_input high homelab-mailread/maildir_base_path || true
db_input high homelab-mailread/introspection_url || true
db_input medium homelab-mailread/behind_proxy || true
db_input medium homelab-mailread/expose_sasl_auth_inet || true
db_input low homelab-mailread/sieve_global_script_path || true
db_go

# Detect existing hand-configured auth (a different, foreign passdb/userdb
# already in the merged config) and pre-seed the overwrite question rather
# than asking blindly — this is the core production-safety check.
if command -v doveconf >/dev/null 2>&1; then
    EXISTING="$(doveconf -n 2>/dev/null | grep -E '^\s*(passdb|userdb)\s' || true)"
    if [ -n "$EXISTING" ]; then
        db_input high homelab-mailread/force_overwrite_detected_config || true
        db_go
    fi
fi

exit 0
