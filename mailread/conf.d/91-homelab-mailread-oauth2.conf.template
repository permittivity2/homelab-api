# Managed by homelab-mailread — do not hand-edit. Tried BEFORE the SQL
# passdb (Dovecot tries passdb blocks in file/declaration order), matching
# the ordering already proven in production. Same JWT introspection
# mechanism already used by IMAP AUTHENTICATE OAUTHBEARER against
# homelab-api's own /api/v1/auth/introspect (see homelab-api issue #012/#015).
passdb {
  driver = oauth2
  args = /etc/dovecot/dovecot-oauth2-homelab.conf.ext
}
