    return _print_response(_request(args, "GET", "/api/v1/mail/status"))


def cmd_mail_folders(args):
    return _print_response(_request(args, "GET", "/api/v1/mail/folders"))


def cmd_mail_messages(args):
    params = {"folder": args.folder}
    if args.offset is not None:
        params["offset"] = args.offset
    if args.limit is not None:
        params["limit"] = args.limit
    return _print_response(_request(args, "GET", "/api/v1/mail/messages", params=params))


def cmd_mail_message(args):
    params = {"folder": args.folder}
    return _print_response(_request(args, "GET", f"/api/v1/mail/messages/{args.uid}", params=params))


def cmd_mail_part(args):
    session = get_session_or_die(args)
    api_url = resolve_api_url(args)
    params = {"folder": args.folder, "part": args.part}
    resp = requests.get(
        f"{api_url}/api/v1/mail/messages/{args.uid}/part",
        headers={"Authorization": f"Bearer {session['token']}"},
        params=params,
        timeout=None,
        stream=True,
    )
    return _save_binary_response(resp, args.output, f"part-{args.uid}-{args.part}.bin")


def cmd_mail_search(args):
    params = {"folder": args.folder}
    for key in ("from_", "to", "subject", "body", "since", "before", "limit"):
        val = getattr(args, key)
        if val is not None:
            params[key.rstrip("_")] = val
    for flag in ("unseen", "seen", "flagged", "unflagged"):
        if getattr(args, flag):
            params[flag] = "1"
    return _print_response(_request(args, "GET", "/api/v1/mail/search", params=params))


def cmd_mail_flags(args):
    body = {}
    if args.add:
        body["add"] = args.add
    if args.remove:
        body["remove"] = args.remove
    params = {"folder": args.folder}
    return _print_response(_request(
        args, "POST", f"/api/v1/mail/messages/{args.uid}/flags", params=params, json=body
    ))


def cmd_mail_move(args):
    body = {"folder": args.folder, "to": args.to}
    return _print_response(_request(args, "POST", f"/api/v1/mail/messages/{args.uid}/move", json=body))


def cmd_mail_trash(args):
    params = {"folder": args.folder}
    return _print_response(_request(args, "DELETE", f"/api/v1/mail/messages/{args.uid}", params=params))


def cmd_mail_purge(args):
    return _print_response(_request(args, "DELETE", f"/api/v1/mail/messages/{args.uid}/permanent"))


def cmd_mail_folder_create(args):
    return _print_response(_request(args, "POST", "/api/v1/mail/folders", json={"name": args.name}))


def cmd_mail_folder_rename(args):
    body = {"name": args.name, "to": args.to}
    return _print_response(_request(args, "PATCH", "/api/v1/mail/folders", json=body))


def cmd_mail_folder_delete(args):
    return _print_response(_request(args, "DELETE", "/api/v1/mail/folders", params={"name": args.name}))


def cmd_mail_allowed_from(args):
    return _print_response(_request(args, "GET", "/api/v1/mail/allowed-senders"))


def _build_mail_message(args):
    message = {
        "from": args.from_,
        "subject": args.subject,
    }
    if args.to:
        message["to"] = args.to
    if args.cc:
        message["cc"] = args.cc
    if args.bcc:
        message["bcc"] = args.bcc
    if args.body:
        message["text_body"] = args.body
    if args.html:
        message["html_body"] = args.html
    if args.attach_drive:
        message["drive_attachment_ids"] = [int(i) for i in args.attach_drive]
    if args.in_reply_to:
        folder, _, uid = args.in_reply_to.partition(":")
        if not uid:
            print("--in-reply-to must be in FOLDER:UID form.", file=sys.stderr)
            sys.exit(1)
        message["in_reply_to"] = {"folder": folder, "uid": uid}
    return message


def _send_mail_multipart(args, path):
    session = get_session_or_die(args)
    api_url = resolve_api_url(args)
    url = f"{api_url}{path}"
    message = _build_mail_message(args)

    def _attempt(bearer_token):
        file_handles = []
        try:
            # MultipartEncoder needs a list of (name, value) tuples, not a
            # dict, to send multiple fields under the same name ("attach")
            # -- a real divergence from cmd_upload_file's single-file dict,
            # since that command never needed more than one "file" field.
            fields = [("message", json.dumps(message))]
            for path_ in (args.attach_file or []):
                fh = open(path_, "rb")
                file_handles.append(fh)
                fields.append(("attach", (os.path.basename(path_), fh, "application/octet-stream")))
            encoder = MultipartEncoder(fields=fields)
            headers = {
                "Authorization": f"Bearer {bearer_token}",
                "Content-Type": encoder.content_type,
            }
            return requests.post(url, data=encoder, headers=headers, timeout=None)
        finally:
            for fh in file_handles:
                fh.close()

    # Not routed through the shared _request() wrapper for the same reason
    # as cmd_upload_file: the encoder wraps consumed-once file streams, so
    # a 401 retry needs freshly-reopened handles, not a resend of the same
    # (already-read) body.
    resp = _attempt(session["token"])
    if resp.status_code == 401:
        new_session = _do_refresh(args)
        if new_session is None:
            print("Session expired, please run 'homelab-cli login' again.", file=sys.stderr)
            sys.exit(1)
        resp = _attempt(new_session["token"])
    return _print_response(resp)


def cmd_mail_send(args):
    return _send_mail_multipart(args, "/api/v1/mail/send")


def cmd_mail_draft(args):
    return _send_mail_multipart(args, "/api/v1/mail/drafts")


