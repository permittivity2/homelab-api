# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

def build_parser():
    parser = argparse.ArgumentParser(
        prog="homelab-cli",
        description="Command-line client for the Homelab API.",
        epilog="Run 'homelab-cli <command> --help' for details on a specific command.",
    )
    parser.add_argument(
        "--api-url",
        metavar="URL",
        help="Override the API base URL for this invocation only (never persisted; "
             "use 'configure --set-api-url' to change it permanently).",
    )
    parser.add_argument(
        "--config",
        metavar="DIR",
        help="Override the config/session directory for this invocation (default: "
             "~/.config/homelab-cli, or $HOMELAB_CLI_CONFIG_DIR if set). Required for "
             "service-account use (e.g. homelab-backup-client/-server) so each caller's "
             "session.json doesn't collide with a human's.",
    )

    sub = parser.add_subparsers(dest="command", required=True, metavar="command")

    def add(name, func, help_, description=None):
        p = sub.add_parser(name, help=help_, description=description or help_)
        p.set_defaults(func=func)
        return p

    def add_group(name, help_):
        """Registers a top-level command group (e.g. 'drive') and returns an
        `add`-like helper scoped to that group's own nested subcommands, so
        call sites read identically to the flat add(...) calls above."""
        group_parser = sub.add_parser(name, help=help_, description=help_)
        group_sub = group_parser.add_subparsers(dest="subcommand", required=True, metavar="command")

        def add_sub(subname, func, help_, description=None):
            p = group_sub.add_parser(subname, help=help_, description=description or help_)
            p.set_defaults(func=func)
            return p

        return add_sub

    # --- Session / configuration ---
    p = add("login", cmd_login, "Log in and save a session for later commands.")
    p.add_argument("--email", help="Account email. Prompted if omitted.")
    g = p.add_mutually_exclusive_group()
    g.add_argument(
        "--password", help="Password (visible in process listings — prefer "
        "--password-stdin or --password-env for scripted/service-account use).",
    )
    g.add_argument(
        "--password-stdin", action="store_true",
        help="Read the password from stdin (one line).",
    )
    g.add_argument(
        "--password-env", metavar="VAR",
        help="Read the password from environment variable VAR.",
    )

    add("logout", cmd_logout, "Log out and clear the saved local session.")

    p = add("configure", cmd_configure, "View or permanently change the cached API base URL.")
    p.add_argument("--set-api-url", metavar="URL", help="Permanently set the API base URL.")

    # --- Auth / health ---
    add("validate", cmd_validate, "Check whether the current JWT is valid.")
    add("introspect", cmd_introspect, "Return the email bound to the current JWT (flat response).")
    add("refresh", cmd_refresh, "Manually refresh the JWT using the saved refresh token.")
    add("health", cmd_health, "Check API/database health (no auth required).")

    # --- Mail (IMAP) ---
    mail = add_group("mail", "Mail (IMAP) operations.")
    mail("status", cmd_mail_status, "Show INBOX unseen/total message counts.")

    mail("folders", cmd_mail_folders, "List mail folders/mailboxes.")

    p = mail("messages", cmd_mail_messages, "List messages in a folder (paginated, newest first).")
    p.add_argument("--folder", default="INBOX", help="Folder name. Default: INBOX.")
    p.add_argument("--offset", type=int, help="Pagination offset (message count). Default: 0.")
    p.add_argument("--limit", type=int, help="Max messages to return (max 200). Default: 50.")

    p = mail("message", cmd_mail_message, "Show one message's headers and MIME part list (no content).")
    p.add_argument("uid", help="Message UID.")
    p.add_argument("--folder", default="INBOX", help="Folder name. Default: INBOX.")

    p = mail(
        "part", cmd_mail_part, "Download one message part's decoded content by part number.",
        description="Downloads one MIME part's decoded content, whether it's a text/plain "
                     "body, a text/html body, or a binary attachment -- same command either "
                     "way. Use 'mail message' first to see a message's available part numbers.",
    )
    p.add_argument("uid", help="Message UID.")
    p.add_argument("part", help="Part number (e.g. '1' or '1.2'), as shown by 'mail message'.")
    p.add_argument("--folder", default="INBOX", help="Folder name. Default: INBOX.")
    p.add_argument("--output", help="Local path to save to. Default: derived from the response.")

    p = mail("search", cmd_mail_search, "Search messages in a folder by criteria.")
    p.add_argument("--folder", default="INBOX", help="Folder name. Default: INBOX.")
    p.add_argument("--from", dest="from_", metavar="FROM", help="Match From header (substring).")
    p.add_argument("--to", help="Match To header (substring).")
    p.add_argument("--subject", help="Match Subject header (substring).")
    p.add_argument("--body", help="Match message body (substring, server-side).")
    p.add_argument("--since", help="Only messages on/after this date (YYYY-MM-DD).")
    p.add_argument("--before", help="Only messages before this date (YYYY-MM-DD).")
    p.add_argument("--unseen", action="store_true", help="Only unread messages.")
    p.add_argument("--seen", action="store_true", help="Only read messages.")
    p.add_argument("--flagged", action="store_true", help="Only flagged messages.")
    p.add_argument("--unflagged", action="store_true", help="Only unflagged messages.")
    p.add_argument("--limit", type=int, help="Max results to return (max 200). Default: 50.")

    p = mail("flags", cmd_mail_flags, r"Add or remove flags on a message (e.g. \Seen, \Flagged).")
    p.add_argument("uid", help="Message UID.")
    p.add_argument("--folder", default="INBOX", help="Folder name. Default: INBOX.")
    p.add_argument("--add", action="append", metavar="FLAG", help="Flag to add. Repeatable.")
    p.add_argument("--remove", action="append", metavar="FLAG", help="Flag to remove. Repeatable.")

    p = mail("move", cmd_mail_move, "Move a message to another folder.")
    p.add_argument("uid", help="Message UID.")
    p.add_argument("to", help="Destination folder name.")
    p.add_argument("--folder", default="INBOX", help="Source folder name. Default: INBOX.")

    p = mail("trash", cmd_mail_trash, "Move a message to the account's Trash folder (recoverable).")
    p.add_argument("uid", help="Message UID.")
    p.add_argument("--folder", default="INBOX", help="Source folder name. Default: INBOX.")

    p = mail(
        "purge", cmd_mail_purge, "Permanently delete a message. Irreversible.",
        description="Permanently deletes a message. Only works on a message already sitting "
                     "in the account's Trash folder -- it cannot target a live mailbox, by "
                     "design, and has no --folder option for that reason. Irreversible.",
    )
    p.add_argument("uid", help="Message UID, as it currently exists within the Trash folder.")

    p = mail("folder-create", cmd_mail_folder_create, "Create a new mail folder.")
    p.add_argument("name", help="New folder name.")

    p = mail(
        "folder-rename", cmd_mail_folder_rename,
        "Rename a mail folder. Refuses special-use folders (INBOX, Trash, Sent, etc.).",
    )
    p.add_argument("name", help="Current folder name.")
    p.add_argument("to", help="New folder name.")

    p = mail(
        "folder-delete", cmd_mail_folder_delete,
        "Delete a mail folder. Refuses special-use folders (INBOX, Trash, Sent, etc.).",
    )
    p.add_argument("name", help="Folder name to delete.")

    mail(
        "allowed-from", cmd_mail_allowed_from,
        "List which addresses and domains the current account may send mail as.",
    )

    def _add_compose_args(p, require_to_subject):
        p.add_argument("--from", dest="from_", required=True, metavar="FROM", help="From address.")
        p.add_argument("--to", action="append", required=require_to_subject, help="Recipient. Repeatable.")
        p.add_argument("--cc", action="append", help="Cc recipient. Repeatable.")
        p.add_argument("--bcc", action="append", help="Bcc recipient. Repeatable.")
        p.add_argument("--subject", required=require_to_subject, help="Subject.")
        p.add_argument("--body", help="Plain-text body.")
        p.add_argument("--html", help="HTML body.")
        p.add_argument(
            "--attach-file", action="append", metavar="PATH",
            help="Local file to attach (uploaded fresh). Repeatable.",
        )
        p.add_argument(
            "--attach-drive", action="append", metavar="ID",
            help="Existing Drive file id to attach by reference (no re-upload). "
                 "Use the numeric file id from 'drive list-files', not its uuid. "
                 "A directory id is rejected: attaching a whole directory is not "
                 "yet implemented. Repeatable.",
        )
        p.add_argument(
            "--in-reply-to", metavar="FOLDER:UID",
            help="Thread this message as a reply to an existing message "
                 "(sets In-Reply-To/References). Example: INBOX:1234.",
        )

    p = mail(
        "send", cmd_mail_send, "Compose and send a message.",
        description="Composes and sends a message via SMTP, then best-effort files a copy "
                     "into the account's Sent folder. --from must be an address or domain "
                     "already returned by 'mail allowed-from'.",
    )
    _add_compose_args(p, require_to_subject=True)

    p = mail(
        "draft", cmd_mail_draft, "Compose and save a draft (does not send).",
        description="Builds the same MIME message as 'mail send' but appends it to the "
                     "account's Drafts folder instead of transmitting it. --to/--subject "
                     "are optional since a draft may be incomplete.",
    )
    _add_compose_args(p, require_to_subject=False)

    # --- Drive (file/directory/share operations) ---
    drive = add_group("drive", "Drive file/directory/share operations.")

    p = drive("share-meta", cmd_share_meta, "Get metadata for a public file share link.")
    p.add_argument("token", help="Share token from the share URL.")

    p = drive("share-dir", cmd_share_dir, "Get metadata + file list for a public directory share link.")
    p.add_argument("token", help="Share token from the share URL.")

    p = drive("share-download", cmd_share_download, "Download a file via a public share link.")
    p.add_argument("token", help="Share token from the share URL.")
    p.add_argument("--output", help="Local path to save to. Default: derived from the response.")

    drive("quota", cmd_quota, "Show usage/limit/file count for the current user.")

    p = drive("file-info", cmd_file_info, "List files by path or directory id.")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--path", help="List files under this path (root-relative).")
    g.add_argument("--dir-id", help="List files in this directory id.")
    p.add_argument("--startat", type=int, help="Pagination offset (1000 results/page).")
    p.add_argument("--recursive", action="store_true", help="Recurse into subdirectories.")

    # Pure alias for file-info (identical handler, identical args) -- added
    # purely for discoverability, since "file-info" doesn't read as "list
    # files". No new server-side capability.
    p = drive("list-files", cmd_file_info, "List files by path or directory id (alias for file-info).")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--path", help="List files under this path (root-relative).")
    g.add_argument("--dir-id", help="List files in this directory id.")
    p.add_argument("--startat", type=int, help="Pagination offset (1000 results/page).")
    p.add_argument("--recursive", action="store_true", help="Recurse into subdirectories.")

    p = drive("upload-file", cmd_upload_file, "Upload a local file to Drive.")
    p.add_argument("file", help="Local file path to upload.")
    p.add_argument("--dir-id", help="Destination directory id. Default: root.")

    p = drive("file-meta", cmd_file_meta, "Show lightweight metadata for a file (no disk I/O).")
    p.add_argument("id", help="File id.")
    p.add_argument("--version", help="Specific version id. Default: current version.")

    p = drive("download-file", cmd_download_file, "Download a file's content.")
    p.add_argument("id", help="File id.")
    p.add_argument("--version", help="Specific version id. Default: current version.")
    p.add_argument("--output", help="Local path to save to. Default: derived from the response.")

    p = drive("trash-file", cmd_trash_file, "Move a file to Trash (soft delete).")
    p.add_argument("id", help="File id.")

    p = drive("move-file", cmd_move_file, "Move (or rename via path) a file.")
    p.add_argument("id", help="File id.")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--to-path", help="Destination path.")
    g.add_argument("--dir-id", help="Destination directory id.")

    p = drive("copy-file", cmd_copy_file, "Queue an async copy of a file.")
    p.add_argument("id", help="File id.")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--to-path", help="Destination path.")
    g.add_argument("--dir-id", help="Destination directory id.")
    p.add_argument("--name", help="Optional new name for the copy.")

    p = drive("file-versions", cmd_file_versions, "List all versions of a file.")
    p.add_argument("id", help="File id.")

    drive("list-trash", cmd_list_trash, "List trashed files with their original path.")

    p = drive("restore-file", cmd_restore_file, "Restore one file from Trash.")
    p.add_argument("id", help="File id.")

    drive("empty-trash", cmd_empty_trash, "Permanently empty Trash (frees quota, deletes on-disk data).")

    drive("trash-dir", cmd_trash_dir, "Get (or create) the user's Trash directory id.")

    p = drive("list-directories", cmd_list_directories, "List directories.")
    p.add_argument("--parent-id", help="List only direct children of this directory. Default: all directories, flat.")

    p = drive("create-directory", cmd_create_directory, "Create a directory.")
    p.add_argument("--name", required=True, help="Directory name.")
    p.add_argument(
        "--parent-id",
        help="Parent directory id. Omit this flag entirely to create the directory "
             "at the root level — do not pass the word NULL/none, which is treated "
             "as a literal (invalid) directory id, not as \"no parent\".",
    )

    p = drive("delete-directory", cmd_delete_directory, "Recursively trash and delete a directory tree.")
    p.add_argument("id", help="Directory id.")

    p = drive("update-directory", cmd_update_directory, "Move or rename a directory.")
    p.add_argument("id", help="Directory id.")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--parent-id", help="Move under this parent directory id.")
    g.add_argument("--name", help="Rename to this name.")

    p = drive("share-file", cmd_share_file, "Create a share for a file.")
    p.add_argument("id", help="File id.")
    p.add_argument("--share-with", help="Email to share with. Omit for a public link.")
    p.add_argument("--permission", choices=["read", "write"], help="Default: read.")

    p = drive("share-directory", cmd_share_directory, "Create a share for a directory.")
    p.add_argument("id", help="Directory id.")
    p.add_argument("--share-with", help="Email to share with. Omit for a public link.")
    p.add_argument("--permission", choices=["read", "write"], help="Default: read.")

    drive("list-shares", cmd_list_shares, "List shares you created.")
    drive("list-shares-with-me", cmd_list_shares_with_me, "List shares others created targeting you.")

    p = drive("delete-share", cmd_delete_share, "Revoke a share you own.")
    p.add_argument("id", help="Share id.")

    p = drive("bulk-trash", cmd_bulk_trash, "Trash multiple files/directories at once.")
    p.add_argument("--file-ids", nargs="+", help="File ids to trash.")
    p.add_argument("--dir-ids", nargs="+", help="Directory ids to trash.")
    p.add_argument("--current-dir-id", help="Directory the file-ids are expected to be in (stale-selection guard).")

    p = drive("bulk-restore", cmd_bulk_restore, "Restore multiple files from Trash at once.")
    p.add_argument("--file-ids", nargs="+", help="File ids to restore.")
    p.add_argument("--dir-id", help="Destination directory id. Default: root.")

    p = drive("bulk-move", cmd_bulk_move, "Move multiple files/directories at once.")
    p.add_argument("--file-ids", nargs="+", help="File ids to move.")
    p.add_argument("--dir-ids", nargs="+", help="Directory ids to move.")
    p.add_argument("--dir-id", help="Destination directory id. Default: root.")

    p = drive("bulk-copy", cmd_bulk_copy, "Copy multiple files/directories at once.")
    p.add_argument("--file-ids", nargs="+", help="File ids to copy.")
    p.add_argument("--dir-ids", nargs="+", help="Directory ids to copy.")
    p.add_argument("--dir-id", help="Destination directory id. Default: root.")

    p = drive("create-zip", cmd_create_zip, "Queue an async zip of files/directories.")
    p.add_argument("--file-ids", nargs="+", help="File ids to include.")
    p.add_argument("--dir-ids", nargs="+", help="Directory ids to include.")
    p.add_argument("--dir-id", required=True, help="Destination directory id for the resulting zip.")

    # --- Admin (site_admin only) ---
    admin = add_group("admin", "Site administration (users/roles/permissions).")

    p = admin(
        "user", cmd_admin_user, "Manage user accounts.",
        description="One action flag per invocation. --email identifies the target account "
                     "for every action except --list. 'active' (in --list's output) reflects "
                     "the real, already-enforced dovecot.users.active column (a user with "
                     "active=false cannot log in at all) -- there is currently no action here "
                     "to change it, only to read it.",
    )
    action = p.add_mutually_exclusive_group(required=True)
    action.add_argument(
        "--create", action="store_true",
        help="Create a dovecot.users account (idempotent) and assign it an initial role. "
             "Requires --email and --role. Generates a random server-side password and "
             "prints it once -- never accepts a client-supplied password. If the account "
             "already exists, no password is generated; the role is still (idempotently) "
             "assigned.",
    )
    action.add_argument("--list", action="store_true", help="List all accounts, their roles, and active flag.")
    action.add_argument("--list-roles", action="store_true", help="List --email's roles.")
    action.add_argument("--add-role", metavar="ROLE", help="Assign ROLE to --email.")
    action.add_argument("--remove-role", metavar="ROLE", help="Revoke ROLE from --email.")
    action.add_argument(
        "--reset-password", action="store_true",
        help="Reset --email's password to a random passphrase, printed once. Never accepts "
             "a client-supplied password; not recoverable afterward if lost.",
    )
    action.add_argument("--revoke-all-tokens", action="store_true", help="Revoke all of --email's refresh tokens.")
    action.add_argument(
        "--force-relogin", action="store_true",
        help="Alias of --revoke-all-tokens (identical action, different server endpoint).",
    )
    p.add_argument("--email", help="Target account email.")
    p.add_argument("--role", help="Initial role to assign (--create only, e.g. user, backup, site_admin).")
    p.add_argument("--quota-mb", type=int, help="Mail quota in MB (--create only). Default: 1024.")

    p = admin(
        "role", cmd_admin_role, "Manage roles and their endpoint permissions.",
        description="One action flag per invocation. --role identifies the target role for "
                     "every action except --list and --list-all-available-role-permissions.",
    )
    action = p.add_mutually_exclusive_group(required=True)
    action.add_argument("--create", action="store_true", help="Create a new role (idempotent). Requires --role.")
    action.add_argument(
        "--remove-role", action="store_true",
        help="Delete --role. Refused if it's site_admin/user, or if any user still holds it.",
    )
    action.add_argument("--list", action="store_true", help="List all roles, each with its granted permissions.")
    action.add_argument(
        "--add-permissions", action="store_true",
        help="Grant one or more endpoints to --role (via --permissions). Endpoints already "
             "on the role are left as-is.",
    )
    action.add_argument(
        "--remove-permissions", action="store_true",
        help="Revoke one or more endpoints from --role (via --permissions). Endpoints not "
             "on the role are left as-is.",
    )
    action.add_argument(
        "--list-all-available-role-permissions", action="store_true",
        help="List every endpoint that could be granted to a role.",
    )
    p.add_argument("--role", help="Role name.")
    p.add_argument("--description", help="Description for --create.")
    p.add_argument(
        "--permissions", nargs="+",
        help='One or more endpoint keys for --add-permissions/--remove-permissions, e.g. '
             '"GET /api/v1/drive/quota" "POST /api/v1/backup/enroll".',
    )

    # --- Backup control plane ---
    backup = add_group(
        "backup", "Backup control-plane operations (enrollment, run reporting, host/repo visibility)."
    )

    p = backup("enroll", cmd_backup_enroll, "Submit this host's pubkey for backup-server enrollment.")
    p.add_argument("--identifier", required=True, help="This host's backup identifier.")
    p.add_argument("--hostname", required=True, help="This host's hostname.")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--pubkey", help="Public key contents.")
    g.add_argument("--pubkey-file", help="Path to a public key file.")

    p = backup(
        "list-pending-enrollments", cmd_backup_list_pending_enrollments,
        "List pending enrollment/revocation requests (polled by homelab-backup-server).",
    )
    p.add_argument("--action", choices=["enroll", "revoke"], help="Filter by action. Default: both.")

    p = backup(
        "ack-enrollment", cmd_backup_ack_enrollment,
        "Mark a pending enrollment/revocation as applied.",
    )
    p.add_argument("id", help="Enrollment request id.")
    p.add_argument("--repo-ssh-user", help="Repo SSH user (enroll acks only).")
    p.add_argument("--repo-server", help="Repo server hostname (enroll acks only).")
    p.add_argument("--repo-location", help="Repo location path (enroll acks only).")

    p = backup("revoke-host", cmd_backup_revoke_host, "Queue a pending revocation for a host.")
    p.add_argument("identifier", help="Host identifier to revoke.")

    p = backup("report-run", cmd_backup_report_run, "Report a completed backup run.")
    p.add_argument("--identifier", required=True, help="This host's backup identifier.")
    p.add_argument("--mode", required=True, choices=["full_host", "local_only", "homelab_only", "specific"])
    p.add_argument("--started-at", required=True, help="ISO 8601 timestamp.")
    p.add_argument("--finished-at", required=True, help="ISO 8601 timestamp.")
    p.add_argument("--status", required=True, choices=["success", "warning", "failure"])
    p.add_argument("--archive-name", help="Borg archive name.")
    p.add_argument("--original-size", type=int, help="Original size in bytes.")
    p.add_argument("--compressed-size", type=int, help="Compressed size in bytes.")
    p.add_argument("--deduplicated-size", type=int, help="Deduplicated size in bytes.")
    p.add_argument("--file-count", type=int, help="Number of files backed up.")
    p.add_argument("--error-message", help="Error message, if any.")

    p = backup("report-check", cmd_backup_report_check, "Report a completed integrity check run.")
    p.add_argument("--identifier", required=True, help="This host's backup identifier.")
    p.add_argument("--started-at", required=True, help="ISO 8601 timestamp.")
    p.add_argument("--finished-at", required=True, help="ISO 8601 timestamp.")
    p.add_argument("--status", required=True, choices=["success", "failure"])
    p.add_argument("--error-message", help="Error message, if any.")

    backup("list-hosts", cmd_backup_list_hosts, "List all enrolled backup hosts.")

    p = backup("list-repos", cmd_backup_list_repos, "List registered backup repos.")
    p.add_argument("--identifier", help="Filter to one host. Default: all hosts.")

    p = backup("host-runs", cmd_backup_host_runs, "Show a host's recent backup run history.")
    p.add_argument("identifier", help="Host identifier.")
    p.add_argument("--limit", type=int, help="Max runs to return. Default: 20.")

    backup(
        "server-info", cmd_backup_server_info,
        "Discover the current backup server's hostname/ssh-user/location.",
    )

    p = backup(
        "set-server-info", cmd_backup_set_server_info,
        "Register this host as the backup server (called by homelab-backup-server's own setup).",
    )
    p.add_argument("--hostname", required=True, help="Reachable hostname/IP for backup clients to use.")
    p.add_argument("--ssh-user", required=True, help="SSH user backup clients should connect as.")
    p.add_argument("--location", required=True, help="Backup storage location path on the server.")

    return parser


def main():
    parser = build_parser()
    argcomplete.autocomplete(parser)
    args = parser.parse_args()
    try:
        sys.exit(args.func(args) or 0)
    except requests.RequestException as exc:
        print(f"error: request failed: {exc}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(130)
    except FileNotFoundError as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
