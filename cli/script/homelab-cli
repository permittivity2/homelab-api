def cmd_quota(args):
    return _print_response(_request(args, "GET", "/api/v1/drive/quota"))


def cmd_file_info(args):
    body = {}
    if args.path:
        body["path"] = args.path
    if args.dir_id:
        body["dir_id"] = args.dir_id
    if args.startat is not None:
        body["startat"] = args.startat
    if args.recursive:
        body["recursive"] = args.recursive
    return _print_response(_request(args, "POST", "/api/v1/drive/fileinfo", json=body))


def cmd_upload_file(args):
    session = get_session_or_die(args)
    api_url = resolve_api_url(args)
    url = f"{api_url}/api/v1/drive/files"

    def _attempt(bearer_token):
        with open(args.file, "rb") as fh:
            fields = {}
            if args.dir_id:
                fields["dir_id"] = args.dir_id
            fields["file"] = (os.path.basename(args.file), fh, "application/octet-stream")
            encoder = MultipartEncoder(fields=fields)
            monitor = MultipartEncoderMonitor(
                encoder, lambda m: _print_progress(m.bytes_read, m.len)
            )
            headers = {
                "Authorization": f"Bearer {bearer_token}",
                "Content-Type": monitor.content_type,
            }
            return requests.post(url, data=monitor, headers=headers, timeout=None)

    # Not routed through the shared _request() wrapper: its 401-retry logic
    # resends the same **kwargs, but a MultipartEncoderMonitor is a
    # consumed-once stream — replaying a partially-read one on retry would
    # send a truncated body. Rebuild the file handle/encoder/monitor fresh
    # for each of the (at most two) attempts instead.
    resp = _attempt(session["token"])
    if resp.status_code == 401:
        new_session = _do_refresh(args)
        if new_session is None:
            print("Session expired, please run 'homelab-cli login' again.", file=sys.stderr)
            sys.exit(1)
        resp = _attempt(new_session["token"])
    _finish_progress()
    return _print_response(resp)


def cmd_file_meta(args):
    params = {}
    if args.version:
        params["version"] = args.version
    return _print_response(_request(args, "GET", f"/api/v1/drive/files/{args.id}/meta", params=params))


def cmd_download_file(args):
    session = get_session_or_die(args)
    api_url = resolve_api_url(args)
    params = {"version": args.version} if args.version else {}
    resp = requests.get(
        f"{api_url}/api/v1/drive/files/{args.id}",
        headers={"Authorization": f"Bearer {session['token']}"},
        params=params,
        timeout=None,
        stream=True,
    )
    return _save_binary_response(resp, args.output, f"file-{args.id}.bin")


