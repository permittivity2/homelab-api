def cmd_admin_list_roles(args):
    return _print_response(_request(args, "GET", "/api/v1/admin/roles"))


def cmd_admin_role_permissions(args):
    return _print_response(_request(args, "GET", f"/api/v1/admin/roles/{args.role}/permissions"))


def cmd_admin_grant_permission(args):
    body = {"endpoint": args.endpoint}
    return _print_response(_request(args, "POST", f"/api/v1/admin/roles/{args.role}/permissions", json=body))


def cmd_admin_revoke_permission(args):
    params = {"endpoint": args.endpoint}
    return _print_response(_request(args, "DELETE", f"/api/v1/admin/roles/{args.role}/permissions", params=params))


def cmd_admin_user_roles(args):
    return _print_response(_request(args, "GET", f"/api/v1/admin/users/{args.email}/roles"))


def cmd_admin_grant_role(args):
    body = {"role": args.role}
    return _print_response(_request(args, "POST", f"/api/v1/admin/users/{args.email}/roles", json=body))


def cmd_admin_revoke_role(args):
    return _print_response(_request(args, "DELETE", f"/api/v1/admin/users/{args.email}/roles/{args.role}"))


def cmd_admin_reset_password(args):
    return _print_response(_request(args, "POST", f"/api/v1/admin/users/{args.email}/reset-password"))


