# ---------------------------------------------------------------------------
# Admin (site_admin only) handlers
# ---------------------------------------------------------------------------

def _require(args, *names):
    """Exits with an error listing any of `names` that are missing/empty on
    `args` -- used by the admin user/role dispatchers below since argparse's
    mutually-exclusive-group actions can't each declare their own distinct
    'required' companions."""
    missing = [f"--{n.replace('_', '-')}" for n in names if not getattr(args, n, None)]
    if missing:
        print(f"error: {', '.join(missing)} required for this action", file=sys.stderr)
        sys.exit(2)


def cmd_admin_user(args):
    if args.create:
        _require(args, "email", "role")
        body = {"email": args.email, "role": args.role}
        if args.quota_mb is not None:
            body["quota_mb"] = args.quota_mb
        return _print_response(_request(args, "POST", "/api/v1/admin/users", json=body))

    if args.list:
        return _print_response(_request(args, "GET", "/api/v1/admin/users"))

    if args.list_roles:
        _require(args, "email")
        return _print_response(_request(args, "GET", f"/api/v1/admin/users/{args.email}/roles"))

    if args.add_role:
        _require(args, "email")
        body = {"role": args.add_role}
        return _print_response(_request(args, "POST", f"/api/v1/admin/users/{args.email}/roles", json=body))

    if args.remove_role:
        _require(args, "email")
        return _print_response(
            _request(args, "DELETE", f"/api/v1/admin/users/{args.email}/roles/{args.remove_role}")
        )

    if args.reset_password:
        _require(args, "email")
        return _print_response(_request(args, "POST", f"/api/v1/admin/users/{args.email}/reset-password"))

    # --revoke-all-tokens and --force-relogin hit distinct server endpoints
    # that perform the identical action -- pick whichever name reads better.
    if args.revoke_all_tokens or args.force_relogin:
        _require(args, "email")
        suffix = "force-relogin" if args.force_relogin else "revoke-tokens"
        return _print_response(_request(args, "POST", f"/api/v1/admin/users/{args.email}/{suffix}"))


def cmd_admin_role(args):
    if args.create:
        _require(args, "role")
        body = {"name": args.role}
        if args.description:
            body["description"] = args.description
        return _print_response(_request(args, "POST", "/api/v1/admin/roles", json=body))

    if args.remove_role:
        _require(args, "role")
        return _print_response(_request(args, "DELETE", f"/api/v1/admin/roles/{args.role}"))

    if args.list:
        return _print_response(_request(args, "GET", "/api/v1/admin/roles"))

    if args.list_all_available_role_permissions:
        return _print_response(_request(args, "GET", "/api/v1/admin/permissions"))

    if args.add_permissions or args.remove_permissions:
        _require(args, "role", "permissions")
        method = "POST" if args.add_permissions else "DELETE"
        results = []
        exit_code = 0
        for endpoint in args.permissions:
            if method == "POST":
                resp = _request(
                    args, "POST", f"/api/v1/admin/roles/{args.role}/permissions", json={"endpoint": endpoint}
                )
            else:
                resp = _request(
                    args, "DELETE", f"/api/v1/admin/roles/{args.role}/permissions", params={"endpoint": endpoint}
                )
            if 200 <= resp.status_code < 300:
                try:
                    results.append(resp.json())
                except ValueError:
                    results.append({"endpoint": endpoint})
            else:
                exit_code = 1
                try:
                    results.append({"endpoint": endpoint, "error": resp.json()})
                except ValueError:
                    results.append({"endpoint": endpoint, "error": f"HTTP {resp.status_code}: {resp.text}"})
        print(json.dumps(results, indent=2))
        return exit_code


