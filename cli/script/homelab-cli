def cmd_backup_report_run(args):
    body = {
        "identifier": args.identifier,
        "mode": args.mode,
        "started_at": args.started_at,
        "finished_at": args.finished_at,
        "status": args.status,
    }
    if args.archive_name is not None:
        body["archive_name"] = args.archive_name
    if args.original_size is not None:
        body["original_size_bytes"] = args.original_size
    if args.compressed_size is not None:
        body["compressed_size_bytes"] = args.compressed_size
    if args.deduplicated_size is not None:
        body["deduplicated_size_bytes"] = args.deduplicated_size
    if args.file_count is not None:
        body["file_count"] = args.file_count
    if args.error_message is not None:
        body["error_message"] = args.error_message
    return _print_response(_request(args, "POST", "/api/v1/backup/runs", json=body))


def cmd_backup_report_check(args):
    body = {
        "identifier": args.identifier,
        "started_at": args.started_at,
