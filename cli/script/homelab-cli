#!/usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK
"""Command-line client for the Homelab API.

Wraps every homelab-api REST endpoint as a subcommand, grouped by area
(e.g. `homelab-cli drive quota`, `homelab-cli admin role --list`); a few
session/auth commands (login, logout, configure, health, ...) stay
top-level since they're used before any group context applies. Persists a
login session (JWT + refresh token) under ~/.config/homelab-cli/ and
transparently refreshes an expired JWT on the caller's behalf.

Tab completion is generated from this file's own argparse tree via
argcomplete (see main()) rather than hand-maintained -- there is no
separate completions file to keep in sync when a subcommand/flag is
added or renamed here.
"""

import argparse
import json
import os
import sys
import time
from pathlib import Path

import argcomplete
import requests
from requests_toolbelt.multipart.encoder import MultipartEncoder, MultipartEncoderMonitor

# ---------------------------------------------------------------------------
# Config / session file handling
# ---------------------------------------------------------------------------

def _config_dir(args):
    """Resolves the config/session directory for this invocation: an
    explicit --config flag, then $HOMELAB_CLI_CONFIG_DIR, then the default
    ~/.config/homelab-cli. Service accounts (homelab-backup-client/-server)
    pass --config with their own isolated directory so their session.json
    never collides with a human's."""
    if getattr(args, "config", None):
        return Path(args.config).expanduser()
    if os.environ.get("HOMELAB_CLI_CONFIG_DIR"):
        return Path(os.environ["HOMELAB_CLI_CONFIG_DIR"]).expanduser()
    return Path.home() / ".config" / "homelab-cli"


def _config_path(args):
    return _config_dir(args) / "config.json"


def _session_path(args):
    return _config_dir(args) / "session.json"


def _secure_write_json(config_dir, path, data):
    config_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def _read_json(path):
    if not path.exists():
        return None
    with open(path) as f:
        return json.load(f)


def load_config(args):
    return _read_json(_config_path(args)) or {}


def save_config(args, data):
    _secure_write_json(_config_dir(args), _config_path(args), data)


def load_session(args):
    return _read_json(_session_path(args))


def save_session(args, data):
    _secure_write_json(_config_dir(args), _session_path(args), data)


def clear_session(args):
    try:
        _session_path(args).unlink()
    except FileNotFoundError:
        pass


def resolve_api_url(args):
    if getattr(args, "api_url", None):
        return args.api_url.rstrip("/")

    config = load_config(args)
    if config.get("api_url"):
        return config["api_url"].rstrip("/")

    if not sys.stdin.isatty():
        # A non-interactive caller (e.g. another script shelling out to
        # us, like homelab-backup-server's own setup trying the
        # operator's ambient session first) has no way to answer this
        # prompt -- input() would just crash on EOF instead of failing
        # cleanly. Caught live: this is the common/expected case for
        # that exact call, not a rare edge case.
        print(
            "error: no api_url configured and not running interactively "
            "-- run 'homelab-cli configure --set-api-url URL' first "
            "(use --config DIR beforehand if this should be a different session's config)",
            file=sys.stderr,
        )
        sys.exit(1)

    url = input("Enter the homelab-api base URL (e.g. https://api.mailmasker.org): ").strip()
    url = url.rstrip("/")
    if not url.startswith("http://") and not url.startswith("https://"):
        print("error: URL must start with http:// or https://", file=sys.stderr)
        sys.exit(1)
    config["api_url"] = url
    save_config(args, config)
    return url


def get_session_or_die(args):
    session = load_session(args)
    if not session:
        print("Not logged in. Run 'homelab-cli login' first.", file=sys.stderr)
        sys.exit(1)
    return session


# ---------------------------------------------------------------------------
# HTTP layer
# ---------------------------------------------------------------------------

def _do_refresh(args):
    """Attempt one refresh using the cached refresh_token. Returns the new
    session dict on success, or None on failure (caller decides what to do)."""
    session = load_session(args)
    if not session or not session.get("refresh_token"):
        return None

    api_url = resolve_api_url(args)
    resp = requests.post(
        f"{api_url}/api/v1/auth/refresh",
        cookies={"homelab-token": session["refresh_token"]},
        timeout=30,
    )
    if resp.status_code != 200:
        return None

    body = resp.json()
    new_session = dict(session)
    new_session["token"] = body["token"]
    new_session["refresh_token"] = body["refresh_token"]
    new_session["expires_in"] = body["expires_in"]
    new_session["obtained_at"] = time.time()
    save_session(args, new_session)
    return new_session


def _request(args, method, path, *, auth=True, is_refresh_retry=False, **kwargs):
    """Shared HTTP wrapper. All subcommands go through this. Handles base
    URL resolution and transparent refresh-on-401 (exactly one retry)."""
    api_url = resolve_api_url(args)
    url = f"{api_url}{path}"

    headers = kwargs.pop("headers", {}) or {}
    if auth:
        session = get_session_or_die(args)
        headers["Authorization"] = f"Bearer {session['token']}"

    resp = requests.request(method, url, headers=headers, timeout=60, **kwargs)

    if resp.status_code == 401 and auth and not is_refresh_retry:
        new_session = _do_refresh(args)
        if new_session is None:
            print("Session expired, please run 'homelab-cli login' again.", file=sys.stderr)
            sys.exit(1)
        headers["Authorization"] = f"Bearer {new_session['token']}"
        resp = requests.request(method, url, headers=headers, timeout=60, **kwargs)

    return resp


def _print_response(resp):
    if 200 <= resp.status_code < 300:
        try:
            print(json.dumps(resp.json(), indent=2))
        except ValueError:
            if resp.text:
                print(resp.text)
        return 0

    _die_with_error(resp)


def _die_with_error(resp):
    try:
        print(json.dumps(resp.json(), indent=2), file=sys.stderr)
    except ValueError:
        print(f"HTTP {resp.status_code}: {resp.text}", file=sys.stderr)
    sys.exit(1)


def _human_size(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{int(n)} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def _print_progress(done, total):
    if not sys.stderr.isatty():
        return
    if total:
        pct = min(100, done * 100 // total)
        text = f"{_human_size(done)} / {_human_size(total)} ({pct}%)"
    else:
        text = f"{_human_size(done)} transferred"
    # \x1b[K erases from the cursor to end of line — without it, a shorter
    # line leaves trailing characters from a longer previous one visible
    # (e.g. a stray digit left over from "10%" once it shrinks to "9%").
    sys.stderr.write(f"\r{text}\x1b[K")
    sys.stderr.flush()


def _finish_progress():
    if sys.stderr.isatty():
        sys.stderr.write("\n")
        sys.stderr.flush()


def _save_binary_response(resp, output_path, default_name):
    if not (200 <= resp.status_code < 300):
        _die_with_error(resp)

    if output_path is None:
        disposition = resp.headers.get("Content-Disposition", "")
        output_path = default_name
        if "filename=" in disposition:
            output_path = disposition.split("filename=", 1)[1].strip('"; ')

    total_size = int(resp.headers.get("Content-Length", 0) or 0)
    downloaded = 0
    with open(output_path, "wb") as f:
        for chunk in resp.iter_content(chunk_size=65536):
            f.write(chunk)
            downloaded += len(chunk)
            _print_progress(downloaded, total_size)
    _finish_progress()

    print(f"Saved to {output_path} ({downloaded} bytes)")
    return 0


# ---------------------------------------------------------------------------
# Session / config command handlers
# ---------------------------------------------------------------------------

def cmd_login(args):
    non_interactive_password = args.password or args.password_stdin or args.password_env
    if non_interactive_password and not args.email:
        print("error: --email is required when using --password/--password-stdin/--password-env "
              "(prompting for it would hang under a non-tty caller).", file=sys.stderr)
        sys.exit(1)
    email = args.email or input("Email: ").strip()

    if args.password:
        password = args.password
    elif args.password_stdin:
        password = sys.stdin.readline().rstrip("\n")
    elif args.password_env:
        password = os.environ.get(args.password_env)
        if password is None:
            print(f"error: environment variable {args.password_env} is not set", file=sys.stderr)
            sys.exit(1)
    else:
        import getpass
        password = getpass.getpass("Password: ")

    api_url = resolve_api_url(args)
    resp = requests.post(
        f"{api_url}/api/v1/auth/login",
        json={"email": email, "password": password},
        timeout=30,
    )
    if resp.status_code != 200:
        _die_with_error(resp)

    body = resp.json()
    save_session(args, {
        "token": body["token"],
        "refresh_token": body["refresh_token"],
        "expires_in": body["expires_in"],
        "obtained_at": time.time(),
        "user": body.get("user", {}),
    })
    print(f"Logged in as {email}.")
    return 0


def cmd_logout(args):
    session = load_session(args)
    if session and session.get("refresh_token"):
        api_url = resolve_api_url(args)
        try:
            resp = requests.post(
                f"{api_url}/api/v1/auth/logout",
                cookies={"homelab-token": session["refresh_token"]},
                timeout=30,
            )
            if resp.status_code != 200:
                print(f"warning: server logout call failed (HTTP {resp.status_code})", file=sys.stderr)
        except requests.RequestException as exc:
            print(f"warning: server logout call failed: {exc}", file=sys.stderr)

    clear_session(args)
    print("Logged out.")
    return 0


def cmd_configure(args):
    config = load_config(args)
    if args.set_api_url:
        url = args.set_api_url.rstrip("/")
        if not url.startswith("http://") and not url.startswith("https://"):
            print("error: URL must start with http:// or https://", file=sys.stderr)
            return 1
        config["api_url"] = url
        save_config(args, config)
        print(f"API URL set to {url}")
    else:
        print(config.get("api_url", "(not set)"))
    return 0


# ---------------------------------------------------------------------------
# Auth / health command handlers
# ---------------------------------------------------------------------------

def cmd_validate(args):
    return _print_response(_request(args, "GET", "/api/v1/auth/validate"))


def cmd_introspect(args):
    return _print_response(_request(args, "GET", "/api/v1/auth/introspect"))


def cmd_refresh(args):
    new_session = _do_refresh(args)
    if new_session is None:
        print("Refresh failed. Run 'homelab-cli login' again.", file=sys.stderr)
        return 1
    print(json.dumps({"token": new_session["token"], "expires_in": new_session["expires_in"]}, indent=2))
    return 0


def cmd_health(args):
    api_url = resolve_api_url(args)
    resp = requests.get(f"{api_url}/api/v1/health", timeout=30)
    return _print_response(resp)


