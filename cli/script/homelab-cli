def _read_pubkey(args):
    if args.pubkey_file:
        with open(args.pubkey_file) as f:
            return f.read().strip()
    return args.pubkey


def cmd_backup_enroll(args):
    body = {"identifier": args.identifier, "hostname": args.hostname, "pubkey": _read_pubkey(args)}
    return _print_response(_request(args, "POST", "/api/v1/backup/enroll", json=body))


