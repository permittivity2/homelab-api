#!/usr/bin/env python3
"""Command-line client for the Homelab API.

Wraps every homelab-api REST endpoint as a subcommand, grouped by area
(e.g. `homelab-cli drive quota`, `homelab-cli admin list-roles`); a few
session/auth commands (login, logout, configure, health, ...) stay
top-level since they're used before any group context applies. Persists a
login session (JWT + refresh token) under ~/.config/homelab-cli/ and
transparently refreshes an expired JWT on the caller's behalf.
"""

import argparse
import json
import os
import sys
import time
from pathlib import Path

import requests
from requests_toolbelt.multipart.encoder import MultipartEncoder, MultipartEncoderMonitor

CONFIG_DIR = Path.home() / ".config" / "homelab-cli"
CONFIG_PATH = CONFIG_DIR / "config.json"
SESSION_PATH = CONFIG_DIR / "session.json"


# ---------------------------------------------------------------------------
# Config / session file handling
# ---------------------------------------------------------------------------

def _secure_write_json(path, data):
    CONFIG_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def _read_json(path):
    if not path.exists():
        return None
    with open(path) as f:
        return json.load(f)


def load_config():
    return _read_json(CONFIG_PATH) or {}


def save_config(data):
    _secure_write_json(CONFIG_PATH, data)


def load_session():
    return _read_json(SESSION_PATH)


def save_session(data):
    _secure_write_json(SESSION_PATH, data)


def clear_session():
    try:
        SESSION_PATH.unlink()
    except FileNotFoundError:
        pass


def resolve_api_url(args):
    if getattr(args, "api_url", None):
        return args.api_url.rstrip("/")

    config = load_config()
    if config.get("api_url"):
        return config["api_url"].rstrip("/")

    url = input("Enter the homelab-api base URL (e.g. https://api.mailmasker.org): ").strip()
    url = url.rstrip("/")
    if not url.startswith("http://") and not url.startswith("https://"):
        print("error: URL must start with http:// or https://", file=sys.stderr)
        sys.exit(1)
    config["api_url"] = url
    save_config(config)
    return url


def get_session_or_die():
    session = load_session()
    if not session:
        print("Not logged in. Run 'homelab-cli login' first.", file=sys.stderr)
        sys.exit(1)
    return session


# ---------------------------------------------------------------------------
# HTTP layer
# ---------------------------------------------------------------------------

def _do_refresh(args):
    """Attempt one refresh using the cached refresh_token. Returns the new
    session dict on success, or None on failure (caller decides what to do)."""
    session = load_session()
    if not session or not session.get("refresh_token"):
        return None

    api_url = resolve_api_url(args)
    resp = requests.post(
        f"{api_url}/api/v1/auth/refresh",
        cookies={"homelab-token": session["refresh_token"]},
        timeout=30,
    )
    if resp.status_code != 200:
        return None

    body = resp.json()
    new_session = dict(session)
    new_session["token"] = body["token"]
    new_session["refresh_token"] = body["refresh_token"]
    new_session["expires_in"] = body["expires_in"]
    new_session["obtained_at"] = time.time()
    save_session(new_session)
    return new_session


def _request(args, method, path, *, auth=True, is_refresh_retry=False, **kwargs):
    """Shared HTTP wrapper. All subcommands go through this. Handles base
    URL resolution and transparent refresh-on-401 (exactly one retry)."""
    api_url = resolve_api_url(args)
    url = f"{api_url}{path}"

    headers = kwargs.pop("headers", {}) or {}
    if auth:
        session = get_session_or_die()
        headers["Authorization"] = f"Bearer {session['token']}"

    resp = requests.request(method, url, headers=headers, timeout=60, **kwargs)

    if resp.status_code == 401 and auth and not is_refresh_retry:
        new_session = _do_refresh(args)
        if new_session is None:
            print("Session expired, please run 'homelab-cli login' again.", file=sys.stderr)
            sys.exit(1)
        headers["Authorization"] = f"Bearer {new_session['token']}"
        resp = requests.request(method, url, headers=headers, timeout=60, **kwargs)

    return resp


def _print_response(resp):
    if 200 <= resp.status_code < 300:
        try:
            print(json.dumps(resp.json(), indent=2))
        except ValueError:
            if resp.text:
                print(resp.text)
        return 0

    _die_with_error(resp)


def _die_with_error(resp):
    try:
        print(json.dumps(resp.json(), indent=2), file=sys.stderr)
    except ValueError:
        print(f"HTTP {resp.status_code}: {resp.text}", file=sys.stderr)
    sys.exit(1)


def _human_size(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{int(n)} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def _print_progress(done, total):
    if not sys.stderr.isatty():
        return
    if total:
        pct = min(100, done * 100 // total)
        text = f"{_human_size(done)} / {_human_size(total)} ({pct}%)"
    else:
        text = f"{_human_size(done)} transferred"
    # \x1b[K erases from the cursor to end of line — without it, a shorter
    # line leaves trailing characters from a longer previous one visible
    # (e.g. a stray digit left over from "10%" once it shrinks to "9%").
    sys.stderr.write(f"\r{text}\x1b[K")
    sys.stderr.flush()


def _finish_progress():
    if sys.stderr.isatty():
        sys.stderr.write("\n")
        sys.stderr.flush()


def _save_binary_response(resp, output_path, default_name):
    if not (200 <= resp.status_code < 300):
        _die_with_error(resp)

    if output_path is None:
        disposition = resp.headers.get("Content-Disposition", "")
        output_path = default_name
        if "filename=" in disposition:
            output_path = disposition.split("filename=", 1)[1].strip('"; ')

    total_size = int(resp.headers.get("Content-Length", 0) or 0)
    downloaded = 0
    with open(output_path, "wb") as f:
        for chunk in resp.iter_content(chunk_size=65536):
            f.write(chunk)
            downloaded += len(chunk)
            _print_progress(downloaded, total_size)
    _finish_progress()

    print(f"Saved to {output_path} ({downloaded} bytes)")
    return 0


# ---------------------------------------------------------------------------
# Session / config command handlers
# ---------------------------------------------------------------------------

def cmd_login(args):
    email = args.email or input("Email: ").strip()
    import getpass
    password = getpass.getpass("Password: ")

    api_url = resolve_api_url(args)
    resp = requests.post(
        f"{api_url}/api/v1/auth/login",
        json={"email": email, "password": password},
        timeout=30,
    )
    if resp.status_code != 200:
        _die_with_error(resp)

    body = resp.json()
    save_session({
        "token": body["token"],
        "refresh_token": body["refresh_token"],
        "expires_in": body["expires_in"],
        "obtained_at": time.time(),
        "user": body.get("user", {}),
    })
    print(f"Logged in as {email}.")
    return 0


def cmd_logout(args):
    session = load_session()
    if session and session.get("refresh_token"):
        api_url = resolve_api_url(args)
        try:
            resp = requests.post(
                f"{api_url}/api/v1/auth/logout",
                cookies={"homelab-token": session["refresh_token"]},
                timeout=30,
            )
            if resp.status_code != 200:
                print(f"warning: server logout call failed (HTTP {resp.status_code})", file=sys.stderr)
        except requests.RequestException as exc:
            print(f"warning: server logout call failed: {exc}", file=sys.stderr)

    clear_session()
    print("Logged out.")
    return 0


def cmd_configure(args):
    config = load_config()
    if args.set_api_url:
        url = args.set_api_url.rstrip("/")
        if not url.startswith("http://") and not url.startswith("https://"):
            print("error: URL must start with http:// or https://", file=sys.stderr)
            return 1
        config["api_url"] = url
        save_config(config)
        print(f"API URL set to {url}")
    else:
        print(config.get("api_url", "(not set)"))
    return 0


# ---------------------------------------------------------------------------
# Auth / health command handlers
# ---------------------------------------------------------------------------

def cmd_validate(args):
    return _print_response(_request(args, "GET", "/api/v1/auth/validate"))


def cmd_introspect(args):
    return _print_response(_request(args, "GET", "/api/v1/auth/introspect"))


def cmd_refresh(args):
    new_session = _do_refresh(args)
    if new_session is None:
        print("Refresh failed. Run 'homelab-cli login' again.", file=sys.stderr)
        return 1
    print(json.dumps({"token": new_session["token"], "expires_in": new_session["expires_in"]}, indent=2))
    return 0


def cmd_health(args):
    api_url = resolve_api_url(args)
    resp = requests.get(f"{api_url}/api/v1/health", timeout=30)
    return _print_response(resp)


# ---------------------------------------------------------------------------
# Mail (IMAP) handlers
# ---------------------------------------------------------------------------

def cmd_mail_status(args):
    return _print_response(_request(args, "GET", "/api/v1/mail/status"))


# ---------------------------------------------------------------------------
# Drive - public share handlers (no auth)
# ---------------------------------------------------------------------------

def cmd_share_meta(args):
    api_url = resolve_api_url(args)
    resp = requests.get(f"{api_url}/api/v1/drive/s/{args.token}/meta", timeout=30)
    return _print_response(resp)


def cmd_share_dir(args):
    api_url = resolve_api_url(args)
    resp = requests.get(f"{api_url}/api/v1/drive/s/{args.token}/dir", timeout=30)
    return _print_response(resp)


def cmd_share_download(args):
    api_url = resolve_api_url(args)
    resp = requests.get(f"{api_url}/api/v1/drive/s/{args.token}", timeout=None, stream=True)
    return _save_binary_response(resp, args.output, f"share-{args.token}.bin")


# ---------------------------------------------------------------------------
# Drive - authenticated handlers
# ---------------------------------------------------------------------------

def cmd_quota(args):
    return _print_response(_request(args, "GET", "/api/v1/drive/quota"))


def cmd_file_info(args):
    body = {}
    if args.path:
        body["path"] = args.path
    if args.dir_id:
        body["dir_id"] = args.dir_id
    if args.startat is not None:
        body["startat"] = args.startat
    if args.recursive:
        body["recursive"] = args.recursive
    return _print_response(_request(args, "POST", "/api/v1/drive/fileinfo", json=body))


def cmd_upload_file(args):
    session = get_session_or_die()
    api_url = resolve_api_url(args)
    url = f"{api_url}/api/v1/drive/files"

    def _attempt(bearer_token):
        with open(args.file, "rb") as fh:
            fields = {}
            if args.dir_id:
                fields["dir_id"] = args.dir_id
            fields["file"] = (os.path.basename(args.file), fh, "application/octet-stream")
            encoder = MultipartEncoder(fields=fields)
            monitor = MultipartEncoderMonitor(
                encoder, lambda m: _print_progress(m.bytes_read, m.len)
            )
            headers = {
                "Authorization": f"Bearer {bearer_token}",
                "Content-Type": monitor.content_type,
            }
            return requests.post(url, data=monitor, headers=headers, timeout=None)

    # Not routed through the shared _request() wrapper: its 401-retry logic
    # resends the same **kwargs, but a MultipartEncoderMonitor is a
    # consumed-once stream — replaying a partially-read one on retry would
    # send a truncated body. Rebuild the file handle/encoder/monitor fresh
    # for each of the (at most two) attempts instead.
    resp = _attempt(session["token"])
    if resp.status_code == 401:
        new_session = _do_refresh(args)
        if new_session is None:
            print("Session expired, please run 'homelab-cli login' again.", file=sys.stderr)
            sys.exit(1)
        resp = _attempt(new_session["token"])
    _finish_progress()
    return _print_response(resp)


def cmd_file_meta(args):
    params = {}
    if args.version:
        params["version"] = args.version
    return _print_response(_request(args, "GET", f"/api/v1/drive/files/{args.id}/meta", params=params))


def cmd_download_file(args):
    session = get_session_or_die()
    api_url = resolve_api_url(args)
    params = {"version": args.version} if args.version else {}
    resp = requests.get(
        f"{api_url}/api/v1/drive/files/{args.id}",
        headers={"Authorization": f"Bearer {session['token']}"},
        params=params,
        timeout=None,
        stream=True,
    )
    return _save_binary_response(resp, args.output, f"file-{args.id}.bin")


def cmd_trash_file(args):
    return _print_response(_request(args, "DELETE", f"/api/v1/drive/files/{args.id}"))


def cmd_move_file(args):
    body = {"to_path": args.to_path} if args.to_path else {"dir_id": args.dir_id}
    return _print_response(_request(args, "PATCH", f"/api/v1/drive/files/{args.id}", json=body))


def cmd_copy_file(args):
    body = {"to_path": args.to_path} if args.to_path else {"dir_id": args.dir_id}
    if args.name:
        body["name"] = args.name
    return _print_response(_request(args, "POST", f"/api/v1/drive/files/{args.id}/copy", json=body))


def cmd_file_versions(args):
    return _print_response(_request(args, "GET", f"/api/v1/drive/files/{args.id}/versions"))


def cmd_list_trash(args):
    return _print_response(_request(args, "GET", "/api/v1/drive/trash"))


def cmd_restore_file(args):
    return _print_response(_request(args, "POST", f"/api/v1/drive/files/{args.id}/restore"))


def cmd_empty_trash(args):
    return _print_response(_request(args, "DELETE", "/api/v1/drive/trash"))


def cmd_trash_dir(args):
    return _print_response(_request(args, "GET", "/api/v1/drive/trash/dir"))


def cmd_list_directories(args):
    params = {"parent_id": args.parent_id} if args.parent_id else {}
    return _print_response(_request(args, "GET", "/api/v1/drive/directories", params=params))


def cmd_create_directory(args):
    body = {"name": args.name}
    if args.parent_id:
        body["parent_id"] = args.parent_id
    return _print_response(_request(args, "POST", "/api/v1/drive/directories", json=body))


def cmd_delete_directory(args):
    return _print_response(_request(args, "DELETE", f"/api/v1/drive/directories/{args.id}"))


def cmd_update_directory(args):
    body = {"parent_id": args.parent_id} if args.parent_id else {"name": args.name}
    return _print_response(_request(args, "PATCH", f"/api/v1/drive/directories/{args.id}", json=body))


def cmd_share_file(args):
    body = {}
    if args.share_with:
        body["share_with"] = args.share_with
    if args.permission:
        body["permission"] = args.permission
    return _print_response(_request(args, "POST", f"/api/v1/drive/files/{args.id}/share", json=body))


def cmd_share_directory(args):
    body = {}
    if args.share_with:
        body["share_with"] = args.share_with
    if args.permission:
        body["permission"] = args.permission
    return _print_response(_request(args, "POST", f"/api/v1/drive/directories/{args.id}/share", json=body))


def cmd_list_shares(args):
    return _print_response(_request(args, "GET", "/api/v1/drive/shares"))


def cmd_list_shares_with_me(args):
    return _print_response(_request(args, "GET", "/api/v1/drive/shares/with-me"))


def cmd_delete_share(args):
    return _print_response(_request(args, "DELETE", f"/api/v1/drive/shares/{args.id}"))


def cmd_bulk_trash(args):
    body = {
        "file_ids": args.file_ids or [],
        "dir_ids": args.dir_ids or [],
        "current_dir_id": args.current_dir_id,
    }
    return _print_response(_request(args, "POST", "/api/v1/drive/bulk/trash", json=body))


def cmd_bulk_restore(args):
    body = {"file_ids": args.file_ids or []}
    if args.dir_id:
        body["dir_id"] = args.dir_id
    return _print_response(_request(args, "POST", "/api/v1/drive/bulk/restore", json=body))


def cmd_bulk_move(args):
    body = {
        "file_ids": args.file_ids or [],
        "dir_ids": args.dir_ids or [],
        "dir_id": args.dir_id,
    }
    return _print_response(_request(args, "POST", "/api/v1/drive/bulk/move", json=body))


def cmd_bulk_copy(args):
    body = {
        "file_ids": args.file_ids or [],
        "dir_ids": args.dir_ids or [],
    }
    if args.dir_id:
        body["dir_id"] = args.dir_id
    return _print_response(_request(args, "POST", "/api/v1/drive/bulk/copy", json=body))


def cmd_create_zip(args):
    body = {
        "file_ids": args.file_ids or [],
        "dir_ids": args.dir_ids or [],
        "dir_id": args.dir_id,
    }
    return _print_response(_request(args, "POST", "/api/v1/drive/zip", json=body))


