def cmd_bulk_restore(args):
    body = {"file_ids": args.file_ids or []}
    if args.dir_id:
        body["dir_id"] = args.dir_id
    return _print_response(_request(args, "POST", "/api/v1/drive/bulk/restore", json=body))


def cmd_bulk_move(args):
    body = {
        "file_ids": args.file_ids or [],
        "dir_ids": args.dir_ids or [],
        "dir_id": args.dir_id,
    }
    return _print_response(_request(args, "POST", "/api/v1/drive/bulk/move", json=body))


def cmd_bulk_copy(args):
    body = {
        "file_ids": args.file_ids or [],
        "dir_ids": args.dir_ids or [],
