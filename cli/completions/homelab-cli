# bash completion for homelab-cli
#
# Generated dynamically from the script's own argparse tree via argcomplete
# (see the `argcomplete.autocomplete(parser)` call in script/homelab-cli's
# main()) -- there is nothing to hand-maintain here. This file previously
# duplicated every subcommand/flag name in a static bash case-statement,
# which drifted out of sync with argparse more than once; argcomplete
# consults the real parser at each TAB press instead, so it can't drift.
#
# This does mean each completion request execs a fresh Python interpreter
# (parser construction only, no network calls -- those happen only once a
# command actually runs, well after argparse has finished). Measured at
# roughly 20-50ms, well under the point of being noticeable, and the same
# tradeoff tools like kubectl/aws-cli/docker/gcloud all make.
#
# The register-python-argcomplete binary name has varied across
# argcomplete packaging/distro versions -- some ship only the versioned
# register-python-argcomplete3 -- so try both rather than assuming one.
if command -v register-python-argcomplete >/dev/null 2>&1; then
    eval "$(register-python-argcomplete homelab-cli)"
elif command -v register-python-argcomplete3 >/dev/null 2>&1; then
    eval "$(register-python-argcomplete3 homelab-cli)"
fi
