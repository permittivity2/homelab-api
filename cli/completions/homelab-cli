# bash completion for homelab-cli
#
# Subcommand names and per-command flags below are hand-kept in sync with
# script/homelab-cli's argparse definitions (there is no code-generation
# step) — if a subcommand or flag is added there, mirror it here too.
#
# Commands are two-level: a handful of top-level session/auth commands
# (login, health, ...) plus command GROUPS (drive, admin, ...), each with
# their own subcommands (e.g. "drive quota", "admin list-roles").

# Value-taking flags across all subcommands. Used both to decide what (if
# anything) to complete for a flag's value, and to correctly skip over
# flag values when counting how many positional arguments have already
# been given (e.g. "drive upload-file --dir-id 59 <TAB>" must not mistake
# "59" for upload-file's own positional file argument).
_homelab_cli_value_flags="--email --set-api-url --path --dir-id --startat \
--parent-id --version --output --to-path --name --share-with --permission \
--current-dir-id --endpoint --role --file-ids --dir-ids --folder --offset --limit \
--from --to --subject --body --since --before --add --remove"

_homelab_cli_is_value_flag() {
    local flag="$1" f
    for f in $_homelab_cli_value_flags; do
        [[ "$flag" == "$f" ]] && return 0
    done
    return 1
}

# Local filesystem path completion — delegates to the bash-completion
# package's own _filedir helper (handles ~ expansion, trailing slashes on
# directories, etc.) when available, else a plain compgen -f fallback.
_homelab_cli_filecomplete() {
    if declare -F _filedir >/dev/null 2>&1; then
        _filedir
    else
        COMPREPLY=( $(compgen -f -- "$cur") )
    fi
}

_homelab_cli_top_commands="login logout configure validate introspect refresh health mail drive admin"
_homelab_cli_group_names="mail drive admin"

_homelab_cli_mail_subcommands="status folders messages message part search \
flags move trash purge folder-create folder-rename folder-delete \
allowed-from send draft"

_homelab_cli_drive_subcommands="share-meta share-dir share-download quota \
file-info list-files upload-file file-meta download-file trash-file move-file \
copy-file file-versions list-trash restore-file empty-trash trash-dir \
list-directories create-directory delete-directory update-directory \
share-file share-directory list-shares list-shares-with-me delete-share \
bulk-trash bulk-restore bulk-move bulk-copy create-zip"

_homelab_cli_admin_subcommands="list-roles role-permissions grant-permission \
revoke-permission user-roles grant-role revoke-role reset-password \
revoke-tokens force-relogin"

_homelab_cli_is_group() {
    local name="$1" g
    for g in $_homelab_cli_group_names; do
        [[ "$name" == "$g" ]] && return 0
    done
    return 1
}

_homelab_cli_subcommands_for_group() {
    case "$1" in
        mail) echo "$_homelab_cli_mail_subcommands" ;;
        drive) echo "$_homelab_cli_drive_subcommands" ;;
        admin) echo "$_homelab_cli_admin_subcommands" ;;
    esac
}

_homelab_cli_completions() {
    local cur prev group subcommand opts i word skip positional_count
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Completing the VALUE of a flag: only --output is a local path.
    # Every other value-taking flag is a remote id/string with nothing
    # sensible to complete locally, so return with no suggestions.
    if _homelab_cli_is_value_flag "$prev"; then
        if [[ "$prev" == "--output" ]]; then
            _homelab_cli_filecomplete
        fi
        return 0
    fi

    # Walk the command line: first non-flag word is the top-level command
    # (or group); if it's a group, the next non-flag word is its
    # subcommand; everything after that is counted as positional args,
    # skipping over each value-taking flag's value as we go.
    group=""
    subcommand=""
    positional_count=0
    skip=0
    for (( i=1; i < COMP_CWORD; i++ )); do
        word="${COMP_WORDS[i]}"
        if [[ $skip -eq 1 ]]; then
            skip=0
            continue
        fi
        if _homelab_cli_is_value_flag "$word"; then
            skip=1
            continue
        fi
        [[ "$word" == -* ]] && continue

        if [[ -z "$group" ]]; then
            group="$word"
        elif _homelab_cli_is_group "$group" && [[ -z "$subcommand" ]]; then
            subcommand="$word"
        else
            positional_count=$((positional_count + 1))
        fi
    done

    # Nothing typed yet: top-level commands + group names.
    if [[ -z "$group" ]]; then
        COMPREPLY=( $(compgen -W "-h --help --api-url $_homelab_cli_top_commands" -- "$cur") )
        return 0
    fi

    # Typed a group name but no subcommand yet: complete that group's
    # subcommands.
    if _homelab_cli_is_group "$group" && [[ -z "$subcommand" ]]; then
        COMPREPLY=( $(compgen -W "-h --help $(_homelab_cli_subcommands_for_group "$group")" -- "$cur") )
        return 0
    fi

    # upload-file's positional `file` argument is a local path — but only
    # offer path completion when the user is actually typing a bare word,
    # not when they're mid-flag-name (e.g. "drive upload-file --dir<TAB>"
    # must still complete to --dir-id; argparse accepts the flag and the
    # positional in either order, so both must be completable regardless
    # of which one hasn't been given yet).
    if [[ "$group" == "drive" && "$subcommand" == "upload-file" && $positional_count -eq 0 && "$cur" != -* ]]; then
        _homelab_cli_filecomplete
        return 0
    fi

    case "$group $subcommand" in
        "login") opts="--email" ;;
        "configure") opts="--set-api-url" ;;
        "drive share-download"|"drive download-file") opts="--output --version" ;;
        "drive file-info"|"drive list-files") opts="--path --dir-id --startat --recursive" ;;
        "drive upload-file") opts="--dir-id" ;;
        "drive file-meta") opts="--version" ;;
        "drive move-file"|"drive copy-file") opts="--to-path --dir-id --name" ;;
        "drive list-directories") opts="--parent-id" ;;
        "drive create-directory") opts="--name --parent-id" ;;
        "drive update-directory") opts="--parent-id --name" ;;
        "drive share-file"|"drive share-directory") opts="--share-with --permission" ;;
        "drive bulk-trash") opts="--file-ids --dir-ids --current-dir-id" ;;
        "drive bulk-restore") opts="--file-ids --dir-id" ;;
        "drive bulk-move"|"drive bulk-copy") opts="--file-ids --dir-ids --dir-id" ;;
        "drive create-zip") opts="--file-ids --dir-ids --dir-id" ;;
        "admin grant-permission"|"admin revoke-permission") opts="--endpoint" ;;
        "admin grant-role") opts="--role" ;;
        "mail messages") opts="--folder --offset --limit" ;;
        "mail message") opts="--folder" ;;
        "mail part") opts="--folder --output" ;;
        "mail search") opts="--folder --from --to --subject --body --since --before --unseen --seen --flagged --unflagged --limit" ;;
        "mail flags") opts="--folder --add --remove" ;;
        "mail move") opts="--folder" ;;
        "mail trash") opts="--folder" ;;
        "mail send"|"mail draft") opts="--from --to --cc --bcc --subject --body --html --attach-file --attach-drive --in-reply-to" ;;
        *) opts="" ;;
    esac

    COMPREPLY=( $(compgen -W "-h --help $opts" -- "$cur") )
    return 0
}

complete -F _homelab_cli_completions homelab-cli
