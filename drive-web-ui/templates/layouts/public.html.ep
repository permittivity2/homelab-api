<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= stash('title') // 'Shared — Homelab Drive' %></title>
  <link rel="stylesheet" href="/style.css?v=<%= app->config->{asset_version} // '1' %>">
</head>
<body class="<%= stash('device_class') // 'desktop' %> public-share-body">

<header class="public-share-header">
  <a href="/login" class="public-share-logo">Homelab Drive</a>
  <a href="/login" class="btn btn-primary btn-sm">Sign in</a>
</header>

<main class="public-share-main">
  %= content
</main>

<footer class="public-share-footer">
  <a href="/login">Sign in to Homelab Drive</a>
</footer>

</body>
</html>
