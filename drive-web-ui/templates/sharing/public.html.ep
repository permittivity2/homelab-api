% layout 'public';
% my $is_dir = stash('share_type') eq 'dir';
% title $is_dir ? stash('dir_name') : stash('file_name');

% if (!$is_dir) {
  <div class="pub-file-card">
    <div class="pub-file-icon">📄</div>
    <h1 class="pub-file-name"><%= stash('file_name') %></h1>
    % if (stash('file_size')) {
      <p class="pub-file-meta"><%= format_size(stash('file_size')) %></p>
    % }
    <a href="/s/<%= stash('token') %>/download" class="btn btn-primary pub-download-btn">
      ⬇ Download
    </a>
  </div>

% } else {
  <div class="pub-dir-card">
    <div class="pub-dir-header">
      <span class="pub-dir-icon">📁</span>
      <div>
        <h1 class="pub-dir-name"><%= stash('dir_name') %></h1>
        % if (stash('owner_email')) {
          <p class="pub-dir-owner">Shared by <strong><%= stash('owner_email') =~ s/@.+//r %></strong></p>
        % }
      </div>
    </div>

    % my $files = stash('files') // [];
    % if (@$files) {
      <div class="pub-dir-stats"><%= scalar @$files %> file<%= @$files == 1 ? '' : 's' %></div>
      <table class="pub-dir-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Size</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          % for my $f (@$files) {
            % my $dl = '/s/' . stash('token') . '/files/' . $f->{uuid} . '/download';
            <tr>
              <td class="pub-dir-fname">
                <span class="pub-dir-ficon">📄</span>
                <a href="<%= $dl %>" class="pub-dir-flink"><%= $f->{file_name} %></a>
              </td>
              <td class="pub-dir-fsize"><%= format_size($f->{file_size}) %></td>
              <td class="pub-dir-faction">
                <a href="<%= $dl %>" class="btn btn-secondary btn-sm">⬇ Download</a>
              </td>
            </tr>
          % }
        </tbody>
      </table>
    % } else {
      <p class="pub-dir-empty">This folder is empty.</p>
    % }
  </div>
% }
