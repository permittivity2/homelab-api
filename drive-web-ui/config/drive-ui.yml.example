# Homelab Drive Web UI Configuration
#
# IMPORTANT: If you run more than one instance of this service behind a
# load balancer, all instances must have identical values for 'secrets'.
# Sessions are signed cookies; a mismatched secret causes all sessions
# created by another instance to be rejected.

api:
  base_url: https://api.example.com

# SSO login — this service delegates its login page entirely to
# homelab-sso-ui (see github-repos/homelab-api issue #012); there is no
# local username/password form. Register this client's redirect_uri in
# homelab-sso-ui's own config.yml (its `clients:` list) too.
sso:
  base_url:      https://login.example.com
  client_id:     drive
  client_secret: "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
  redirect_uri:  "https://drive.example.com/login"

# Bump this string on every deploy to bust browser caches for app.js and style.css
asset_version: "45"

# Session signing secrets — CHANGE THIS, keep identical across all drive servers
secrets:
  - "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

session:
  secure: 1         # Set to 0 only for local HTTP development
  expiry: 604800    # 7 days in seconds
  # cookie_name: homelab-drive   # Uncomment and set to preserve sessions across
                                  # a cookie-name change (e.g. during a rename/migration)

upload:
  # Temp directory for incoming uploads before they are forwarded to api.example.com.
  # Must have at least 10GB free. Defaults to system /tmp if unset.
  tmpdir:   /var/lib/homelab/tmp
  max_size: 10737418240   # 10GB in bytes

server:
  listen:   "http://0.0.0.0:2500"
  workers:  4
  pid_file: /var/lib/homelab/drive-ui-hypnotoad.pid
