#!/usr/bin/make -f

PKG = debian/homelab-borg-service-backup-server
DATA_DIR = $(PKG)/usr/share/homelab-borg-service-backup-server

%:
	dh $@

override_dh_install:
	dh_install
	install -D -m 755 homelab-borg-service-backup-server \
		$(PKG)/usr/sbin/homelab-borg-service-backup-server
	install -D -m 755 setup-admin-recovery-key.sh \
		$(DATA_DIR)/setup-admin-recovery-key.sh

override_dh_auto_build:
	# No build step needed for a couple of scripts

override_dh_auto_test:
	# No package-build-time tests
