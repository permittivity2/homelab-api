#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONFIG_FILE=/etc/homelab/processor/config.yml
API_CONFIG_FILE=/etc/homelab/api/config.yml

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$CONFIG_FILE" ]; then
    exit 0
fi

REUSE=false
if [ -f "$API_CONFIG_FILE" ]; then
    db_input high homelab-api-backend-processor/db/reuse_api_config || true
    db_go
    db_get homelab-api-backend-processor/db/reuse_api_config; REUSE="$RET"
fi

if [ "$REUSE" != "true" ]; then
    db_input high homelab-api-backend-processor/db/host || true
    db_input high homelab-api-backend-processor/db/port || true
    db_input high homelab-api-backend-processor/db/name || true
    db_input high homelab-api-backend-processor/db/user || true
    db_input high homelab-api-backend-processor/db/password || true
    db_go
fi

exit 0
