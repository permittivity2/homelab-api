#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/postfix/pgsql-virtual-domains.cf

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-mailsend/db_host || true
db_input high homelab-mailsend/db_port || true
db_input high homelab-mailsend/db_name || true
db_input high homelab-mailsend/db_user || true
db_input high homelab-mailsend/db_password || true
db_input high homelab-mailsend/domains || true
db_input high homelab-mailsend/dovecot_host || true
db_input high homelab-mailsend/dovecot_sasl_mode || true
db_input medium homelab-mailsend/dovecot_lmtp_port || true
db_input medium homelab-mailsend/enable_roundcube_listener || true
db_input medium homelab-mailsend/behind_proxy || true
db_input medium homelab-mailsend/dkim_milter_address || true
db_go

# Pre-seed manage_master_cf_listeners based on an actual scan of the live
# master.cf -- never blindly ask, since the safe default depends on
# whether a conflicting listener already exists (it does, on production).
if [ -f /etc/postfix/master.cf ] && grep -qE '^(submission|smtps)\s+inet' /etc/postfix/master.cf 2>/dev/null; then
    db_set homelab-mailsend/manage_master_cf_listeners false || true
else
    db_set homelab-mailsend/manage_master_cf_listeners true || true
fi

exit 0
