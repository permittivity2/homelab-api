#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/haproxy/conf.d/90-homelab-mail-proxy.cfg

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-mail-proxy/postfix_backend || true
db_input high homelab-mail-proxy/postfix_backend_smtps || true
db_input high homelab-mail-proxy/postfix_backend_submission || true
db_input high homelab-mail-proxy/dovecot_backend || true
db_input high homelab-mail-proxy/dovecot_backend_ssl || true
db_input medium homelab-mail-proxy/enable_roundcube_listener || true
db_input medium homelab-mail-proxy/roundcube_backend || true
db_input low homelab-mail-proxy/rate_25 || true
db_input low homelab-mail-proxy/rate_465 || true
db_input low homelab-mail-proxy/rate_587 || true
db_input low homelab-mail-proxy/rate_10465 || true
db_input low homelab-mail-proxy/rate_imap || true
db_go

exit 0
