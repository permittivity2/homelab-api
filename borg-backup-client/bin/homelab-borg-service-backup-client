#!/usr/bin/env python3
"""Homelab Borg backup client. See /etc/homelab/borgbackup/config.yml."""

import argparse
import contextlib
import getpass
import glob
import json
import logging
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime, timezone

import yaml

try:
    from systemd.journal import JournalHandler
    _HAVE_JOURNAL = True
except ImportError:
    _HAVE_JOURNAL = False

try:
    import psycopg2
    _HAVE_PSYCOPG2 = True
except ImportError:
    _HAVE_PSYCOPG2 = False

DEFAULT_CONFIG_PATH = "/etc/homelab/borgbackup/config.yml"
MACHINE_ID_PATH = "/etc/machine-id"

BORG_CMD = "borg"

DEFAULT_SSH_USER = "borgbackup"
DEFAULT_BACKUP_LOCATION = "/var/borgbackup"

# Dedicated key generated by install.sh; must be passed explicitly via
# BORG_RSH since root's default identity isn't the one trusted by
# borgbackup_server's restricted authorized_keys entry.
SSH_KEY_PATH = "/etc/homelab/borgbackup/ssh/id_ed25519"

# The interactive config-prompting/SSH-trust-bootstrap logic lives in
# install.sh (shared with the non-packaged manual install path) rather
# than being reimplemented here; `configure` just execs the copy shipped
# under this package's data directory. See install/install.sh's
# REPO_ROOT auto-detection and --skip-packages/--skip-binary flags.
CONFIGURE_SCRIPT = "/usr/share/homelab-borg-service-backup-client/install/install.sh"

# Exported alongside each repo's passphrase so the repo can be unlocked
# even if config.yml/the passphrase is lost with the host itself. See
# export_key_escrow(). Escrowing these files off-host (secrets manager +
# an offline/paper copy) is the admin's responsibility -- this tool only
# generates them and makes that unmissable in the install summary.
KEY_ESCROW_DIR = "/etc/homelab/borgbackup/key-escrow"

HEARTBEAT_INTERVAL_SECONDS = 300

PSEUDO_FS_EXCLUDES = ["/proc", "/sys", "/dev", "/run", "/tmp"]

# Mount filesystem types treated as "not local" for mode: local_only.
NETWORK_OR_VIRTUAL_FSTYPES = {
    "nfs", "nfs4", "cifs", "smb3", "smbfs",
    "fuse.sshfs", "sshfs",
    "overlay", "aufs",
    "tmpfs", "devtmpfs", "proc", "sysfs", "devpts",
    "cgroup", "cgroup2", "autofs", "fusectl", "pstore",
    "squashfs", "iso9660",
}

log = logging.getLogger("homelab-borg-service-backup-client")


def setup_logging():
    log.setLevel(logging.INFO)
    if _HAVE_JOURNAL:
        handler = JournalHandler(SYSLOG_IDENTIFIER="homelab-borg-service-backup-client")
    else:
        handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(logging.Formatter("%(message)s"))
    log.addHandler(handler)


def format_duration(seconds):
    seconds = int(seconds)
    hours, rem = divmod(seconds, 3600)
    minutes, secs = divmod(rem, 60)
    if hours:
        return f"{hours}h{minutes:02d}m{secs:02d}s"
    if minutes:
        return f"{minutes}m{secs:02d}s"
    return f"{secs}s"


@contextlib.contextmanager
def heartbeat(label):
    """Log a "still running" line every HEARTBEAT_INTERVAL_SECONDS so a
    long backup doesn't look hung in journalctl. Runs in a daemon thread;
    a thread parked on Event.wait() doesn't block on the main thread's
    subprocess calls (the GIL is released during those OS-level waits)."""
    start = time.monotonic()
    stop = threading.Event()

    def _run():
        while not stop.wait(HEARTBEAT_INTERVAL_SECONDS):
            log.info("still running (%s elapsed): %s", format_duration(time.monotonic() - start), label)

    thread = threading.Thread(target=_run, daemon=True)
    thread.start()
    try:
        yield
    finally:
        stop.set()
        thread.join()


def load_config(path, required=True):
    if not os.path.exists(path):
        if required:
            log.error("config file not found: %s", path)
            sys.exit(1)
        return {}
    with open(path, "r") as f:
        data = yaml.safe_load(f) or {}
    return data


def resolve_identifier(config):
    configured = (config.get("hostname") or "").strip()
    if configured:
        return configured

    system_hostname = socket.gethostname()
    try:
        with open(MACHINE_ID_PATH, "r") as f:
            machine_id = f.read().strip()
    except OSError as exc:
        log.error(
            "hostname not set in config and %s is not accessible (%s); "
            "cannot derive a stable host identifier, exiting cleanly",
            MACHINE_ID_PATH, exc,
        )
        sys.exit(0)

    if not machine_id:
        log.error(
            "hostname not set in config and %s is empty; "
            "cannot derive a stable host identifier, exiting cleanly",
            MACHINE_ID_PATH,
        )
        sys.exit(0)

    return f"{system_hostname}-{machine_id}"


def read_mounts():
    mounts = []
    with open("/proc/mounts", "r") as f:
        for line in f:
            parts = line.split()
            if len(parts) < 3:
                continue
            _dev, mountpoint, fstype = parts[0], parts[1], parts[2]
            mounts.append((mountpoint, fstype))
    return mounts


def build_sources_and_patterns(config, mode, dump_dirs):
    """Return (sources, pattern_lines) for `borg create --patterns-from`.

    Every line we generate is an exclusion, so each is prefixed with the
    Borg patterns-file "-" (exclude) action; a bare pattern with no prefix
    is invalid in a --patterns-from file (unlike --exclude-from).
    """
    excludes = list(config.get("exclude") or [])
    pattern_lines = [f"- re:{pat}" for pat in excludes]

    if mode == "full_host":
        sources = ["/"]
        for p in PSEUDO_FS_EXCLUDES:
            pattern_lines.append(f"! fm:{p}")

    elif mode == "local_only":
        sources = ["/"]
        for p in PSEUDO_FS_EXCLUDES:
            pattern_lines.append(f"! fm:{p}")
        for mountpoint, fstype in read_mounts():
            if mountpoint == "/":
                continue
            if fstype in NETWORK_OR_VIRTUAL_FSTYPES:
                pattern_lines.append(f"! fm:{mountpoint}")

    elif mode == "homelab_only":
        homelab_cfg = config.get("homelab_only") or {}
        sources = list(homelab_cfg.get("paths") or [])
        sources.extend(dump_dirs)
        if not sources:
            log.warning("mode is homelab_only but no paths/databases configured")

    elif mode == "specific":
        specific_cfg = config.get("specific") or {}
        sources = list(specific_cfg.get("paths") or [])
        if not sources:
            log.warning("mode is specific but specific.paths is empty")

    else:
        log.error("unknown mode: %s", mode)
        sys.exit(1)

    return sources, pattern_lines


def dump_databases(config, dry_run):
    """pg_dump each configured database into its dump_dir. Returns list of dump_dirs."""
    homelab_cfg = config.get("homelab_only") or {}
    databases = homelab_cfg.get("databases") or []
    dump_dirs = []
    for db in databases:
        db_type = db.get("type", "postgres")
        name = db.get("name")
        dump_dir = db.get("dump_dir")
        if not name or not dump_dir:
            log.warning("skipping database entry with missing name/dump_dir: %s", db)
            continue
        if db_type != "postgres":
            log.warning("unsupported database type %r for %s, skipping", db_type, name)
            continue

        os.makedirs(dump_dir, exist_ok=True)
        dump_file = os.path.join(dump_dir, f"{name}.sql")
        cmd = ["pg_dump", name, "-f", dump_file]
        log.info("dumping database %s -> %s", name, dump_file)
        if dry_run:
            log.info("[dry-run] would run: %s", " ".join(cmd))
        else:
            subprocess.run(cmd, check=True)
        dump_dirs.append(dump_dir)
    return dump_dirs


BACKUP_HOOK_GLOB = "/usr/share/homelab-*/backup-hook.sh"
HOOK_DUMP_BASE_DIR = "/var/lib/homelab-borg-service-backup-client/dumps"


def run_backup_hooks(dry_run):
    """Runs every installed package's own /usr/share/homelab-<pkg>/
    backup-hook.sh (if present and executable), each into its own
    subdirectory of HOOK_DUMP_BASE_DIR. This is how a package with
    actual data to protect (today, only homelab-database's pg_dumpall)
    gets it backed up -- borg-backup-client never needs to know
    anything Postgres/PowerDNS/etc.-specific itself. Returns the list of
    per-hook output dirs, same shape as dump_databases()'s dump_dirs, so
    both feed the same cleanup_dump_dirs() afterward. A failing hook is
    logged and skipped, never fatal to the rest of the backup -- matches
    the same non-fatal philosophy as the per-database pg_dump loop
    above."""
    dump_dirs = []
    for hook in sorted(glob.glob(BACKUP_HOOK_GLOB)):
        if not os.access(hook, os.X_OK):
            continue
        pkgname = os.path.basename(os.path.dirname(hook))
        out_dir = os.path.join(HOOK_DUMP_BASE_DIR, pkgname)
        os.makedirs(out_dir, exist_ok=True)
        log.info("running backup hook %s -> %s", hook, out_dir)
        if dry_run:
            log.info("[dry-run] would run: %s %s", hook, out_dir)
            dump_dirs.append(out_dir)
            continue
        try:
            subprocess.run([hook, out_dir], check=True)
        except subprocess.CalledProcessError as exc:
            log.warning("backup hook %s failed, skipping: %s", hook, exc)
            continue
        dump_dirs.append(out_dir)
    return dump_dirs


def cleanup_dump_dirs(dump_dirs, dry_run):
    for d in dump_dirs:
        if dry_run:
            log.info("[dry-run] would remove dump dir: %s", d)
            continue
        shutil.rmtree(d, ignore_errors=True)


def _truthy(value):
    """Normalize a config value that should mean "yes"/"no". YAML booleans
    load as real Python bools, but install/configedit.py's set-scalar
    always quotes values it writes (`key: "false"`), which yaml.safe_load
    then hands back as the *string* "false" -- and bool("false") is True.
    Handle both forms explicitly rather than trusting bare bool()."""
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in ("1", "true", "yes", "on")


def build_repo_url(ssh_user, server, location, identifier):
    if not server:
        log.error("no backup server known (borgbackup_server in config.yml, or --server)")
        sys.exit(1)
    # Borg needs a doubled leading slash to treat the remote path as
    # absolute rather than relative to the SSH user's home directory.
    return f"ssh://{ssh_user}@{server}/{location}/{identifier}"


def repo_url(config, identifier):
    ssh_user = config.get("ssh_borgbackup_server_username") or DEFAULT_SSH_USER
    server = config.get("borgbackup_server")
    location = config.get("borgbackup_server_backup_location") or DEFAULT_BACKUP_LOCATION
    return build_repo_url(ssh_user, server, location, identifier)


def build_env(passphrase, ssh_key_path):
    env = dict(os.environ)
    if passphrase:
        env["BORG_PASSPHRASE"] = passphrase
    if ssh_key_path:
        if os.path.exists(ssh_key_path):
            env["BORG_RSH"] = f"ssh -i {ssh_key_path} -o StrictHostKeyChecking=accept-new"
        else:
            log.warning("SSH key %s not found; falling back to default ssh identity", ssh_key_path)
    return env


def run_borg(cmd, env):
    """Run a borg command, relaying its output into our own journal
    identity (otherwise it's tagged as coming from `borg`, not
    `homelab-borg-service-backup-client`, and `journalctl -t
    homelab-borg-service-backup-client` misses it entirely). Borg's exit
    code 1 means "completed with warnings"
    (e.g. a transient race reading a procfs entry) and is not a failure;
    only 2+ is a real error."""
    result = subprocess.run(cmd, env=env, capture_output=True, text=True)
    output = (result.stdout or "") + (result.stderr or "")
    for line in output.splitlines():
        if line.strip():
            log.info("%s: %s", cmd[0], line)

    if result.returncode == 1:
        log.warning("%s exited with warnings (rc=1), continuing", cmd[0])
    elif result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, cmd)


def run_borg_interactive(cmd, env, cwd=None):
    """Like run_borg(), but for admin-driven commands (list-archives,
    restore) where output should stream straight to the terminal rather
    than being captured line-by-line into the journal."""
    log.info("running: %s", " ".join(cmd))
    result = subprocess.run(cmd, env=env, cwd=cwd)
    if result.returncode == 1:
        log.warning("%s exited with warnings (rc=1)", cmd[0])
        return True
    return result.returncode == 0


def run_borg_capture_json(cmd, env):
    """Like run_borg(), but for a command run with --json: returns the
    parsed JSON from stdout instead of logging it line-by-line (a JSON
    blob isn't human-log-friendly). stderr (progress/warnings) is still
    logged normally. Returns None if the run failed to parse -- stats
    are a nice-to-have for the run-tracking database, not load-bearing,
    so a parse failure here doesn't fail the backup."""
    result = subprocess.run(cmd, env=env, capture_output=True, text=True)
    for line in (result.stderr or "").splitlines():
        if line.strip():
            log.info("%s: %s", cmd[0], line)

    if result.returncode == 1:
        log.warning("%s exited with warnings (rc=1), continuing", cmd[0])
    elif result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, cmd)

    try:
        return json.loads(result.stdout)
    except (ValueError, TypeError):
        log.warning("%s: could not parse --json output", cmd[0])
        return None


def _db_safe(fn, *args, **kwargs):
    """Run a db_* helper, turning any exception into a logged warning.
    A database hiccup must never fail or block an actual backup/check."""
    try:
        return fn(*args, **kwargs)
    except Exception as exc:  # noqa: BLE001 -- deliberately broad, see docstring
        log.warning("run-tracking database error (%s): %s", fn.__name__, exc)
        return None


def db_connect(config):
    """Returns an autocommit psycopg2 connection for run-tracking, or
    None if database.enabled is false, psycopg2 isn't installed, or the
    connection fails -- all non-fatal, all logged, never raised."""
    db_cfg = config.get("database") or {}
    if not _truthy(db_cfg.get("enabled")):
        return None
    if not _HAVE_PSYCOPG2:
        log.warning(
            "database.enabled is true but psycopg2 is not installed; "
            "skipping run tracking (apt install python3-psycopg2)"
        )
        return None
    conn = psycopg2.connect(
        host=db_cfg.get("host"),
        port=db_cfg.get("port") or 5432,
        dbname=db_cfg.get("dbname") or "homelab",
        user=db_cfg.get("user"),
        password=db_cfg.get("password"),
        connect_timeout=10,
    )
    conn.autocommit = True
    return conn


def db_get_repo_id(conn, config, identifier):
    """Upserts service_backup.hosts then service_backup.repos (see
    install/schema.sql) and returns the repo's id."""
    ssh_user = config.get("ssh_borgbackup_server_username") or DEFAULT_SSH_USER
    server = config.get("borgbackup_server")
    location = config.get("borgbackup_server_backup_location") or DEFAULT_BACKUP_LOCATION

    with conn.cursor() as cur:
        cur.execute(
            """
            INSERT INTO service_backup.hosts (identifier, hostname)
            VALUES (%s, %s)
            ON CONFLICT (identifier) DO UPDATE
                SET hostname = EXCLUDED.hostname, last_seen_at = now()
            RETURNING id
            """,
            (identifier, socket.gethostname()),
        )
        host_id = cur.fetchone()[0]

        cur.execute(
            """
            INSERT INTO service_backup.repos (host_id, ssh_user, server, location)
            VALUES (%s, %s, %s, %s)
            ON CONFLICT (host_id, ssh_user, server, location) DO UPDATE
                SET host_id = EXCLUDED.host_id
            RETURNING id
            """,
            (host_id, ssh_user, server, location),
        )
        return cur.fetchone()[0]


def db_record_backup_run(conn, repo_id, mode, status, archive_name, started_at, stats, error_message):
    stats = stats or {}
    with conn.cursor() as cur:
        cur.execute(
            """
            INSERT INTO service_backup.backup_runs
                (repo_id, mode, archive_name, started_at, finished_at, status,
                 original_size_bytes, compressed_size_bytes,
                 deduplicated_size_bytes, file_count, error_message)
            VALUES (%s, %s, %s, %s, now(), %s, %s, %s, %s, %s, %s)
            """,
            (
                repo_id, mode, archive_name, started_at, status,
                stats.get("original_size"), stats.get("compressed_size"),
                stats.get("deduplicated_size"), stats.get("nfiles"),
                error_message,
            ),
        )


def db_record_check_run(conn, repo_id, status, started_at, error_message):
    with conn.cursor() as cur:
        cur.execute(
            """
            INSERT INTO service_backup.check_runs
                (repo_id, started_at, finished_at, status, error_message)
            VALUES (%s, %s, now(), %s, %s)
            """,
            (repo_id, started_at, status, error_message),
        )


def export_key_escrow(repo, env, identifier, dry_run):
    """Export the repo's key (independent of the passphrase) so the repo
    can still be opened if config.yml/the passphrase is lost along with
    the host. Idempotent and cheap -- skipped once both files exist, and
    a no-op for unencrypted repos."""
    if not env.get("BORG_PASSPHRASE"):
        return
    if dry_run:
        return

    key_file = os.path.join(KEY_ESCROW_DIR, f"{identifier}.key")
    paper_file = os.path.join(KEY_ESCROW_DIR, f"{identifier}-paper.txt")
    if os.path.exists(key_file) and os.path.exists(paper_file):
        return

    os.makedirs(KEY_ESCROW_DIR, exist_ok=True)
    os.chmod(KEY_ESCROW_DIR, 0o700)
    run_borg([BORG_CMD, "key", "export", repo, key_file], env)
    run_borg([BORG_CMD, "key", "export", "--paper", repo, paper_file], env)
    os.chmod(key_file, 0o600)
    os.chmod(paper_file, 0o600)
    log.warning(
        "borg key exported to %s and %s -- copy these off this host "
        "(secrets manager + an offline/paper copy) now; they are not "
        "replicated anywhere else",
        key_file, paper_file,
    )


def ensure_repo(repo, env, identifier, dry_run):
    if dry_run:
        log.info("[dry-run] would check/init repo: %s", repo)
        return

    check = subprocess.run([BORG_CMD, "info", repo], env=env, capture_output=True, text=True)
    if check.returncode != 0:
        encryption = "repokey" if env.get("BORG_PASSPHRASE") else "none"
        cmd = [BORG_CMD, "init", "--encryption", encryption, repo]
        log.info("repo not found, initializing: %s", " ".join(cmd))
        subprocess.run(cmd, env=env, check=True)

    export_key_escrow(repo, env, identifier, dry_run)


def run_backup(config, dry_run):
    start = time.monotonic()
    wall_start = datetime.now(timezone.utc)
    identifier = resolve_identifier(config)
    mode = config.get("mode", "full_host")

    encryption_cfg = config.get("encryption") or {}
    passphrase = encryption_cfg.get("passphrase") or ""
    allow_unencrypted = _truthy(encryption_cfg.get("allow_unencrypted"))

    # Run-tracking database is entirely optional (database.enabled,
    # default false) and best-effort: db_connect()/db_get_repo_id() never
    # raise, so a database hiccup can never fail or block a real backup.
    # None of this is exercised at all -- not even --json is added to the
    # borg invocation below -- unless a database is actually configured.
    db_conn = None if dry_run else _db_safe(db_connect, config)
    repo_id = _db_safe(db_get_repo_id, db_conn, config, identifier) if db_conn else None

    def finish(status, archive_name=None, stats=None, error_message=None):
        if db_conn and repo_id:
            _db_safe(
                db_record_backup_run, db_conn, repo_id, mode, status,
                archive_name, wall_start, stats, error_message,
            )
        if db_conn:
            db_conn.close()

    if not passphrase and not allow_unencrypted:
        msg = (
            "no encryption passphrase configured; set encryption.passphrase "
            "(auto-generated by install.sh) or explicitly set "
            "encryption.allow_unencrypted: true to back up without encryption"
        )
        log.error(msg)
        finish("failure", error_message=msg)
        return False
    if not passphrase:
        log.warning(
            "no encryption passphrase configured; backing up UNENCRYPTED "
            "(encryption.allow_unencrypted is set)"
        )

    env = build_env(passphrase, SSH_KEY_PATH)

    log.info("starting %s backup for %s", mode, identifier)
    dump_dirs = []
    with heartbeat(f"{mode} backup for {identifier}"):
        try:
            dump_dirs = (
                dump_databases(config, dry_run) + run_backup_hooks(dry_run)
                if mode == "homelab_only" else []
            )

            sources, pattern_lines = build_sources_and_patterns(config, mode, dump_dirs)
            if not sources:
                msg = f"no sources to back up for mode {mode}, aborting"
                log.error(msg)
                finish("failure", error_message=msg)
                return False

            repo = repo_url(config, identifier)
            ensure_repo(repo, env, identifier, dry_run)

            archive_name = f"{mode}-{{now:%Y-%m-%dT%H:%M:%S}}"
            resolved_archive_name = archive_name
            stats = None

            with tempfile.NamedTemporaryFile(
                mode="w", prefix="homelab-borg-service-backup-client-patterns-", suffix=".txt", delete=False
            ) as pf:
                pf.write("\n".join(pattern_lines) + "\n")
                patterns_file = pf.name

            try:
                create_cmd = [
                    BORG_CMD, "create",
                    f"{repo}::{archive_name}",
                    "--patterns-from", patterns_file,
                    "--compression", "zstd",
                    "--stats",
                ] + sources

                log.info("running: %s", " ".join(create_cmd))
                if dry_run:
                    log.info("[dry-run] patterns file:\n%s", "\n".join(pattern_lines))
                elif db_conn and repo_id:
                    # --json also gives us the *resolved* archive name
                    # (today's archive_name is still the {now:...}
                    # template borg itself expands) plus real size/file
                    # stats for the run-tracking database.
                    data = run_borg_capture_json(create_cmd + ["--json"], env)
                    if data:
                        archive_info = data.get("archive") or {}
                        resolved_archive_name = archive_info.get("name") or archive_name
                        stats = archive_info.get("stats") or {}
                else:
                    run_borg(create_cmd, env)
            finally:
                os.unlink(patterns_file)

            retention = config.get("retention") or {}
            prune_cmd = [BORG_CMD, "prune", repo, "-a", f"{mode}-*"]
            for flag, key in (
                ("--keep-daily", "keep_daily"),
                ("--keep-weekly", "keep_weekly"),
                ("--keep-monthly", "keep_monthly"),
                ("--keep-yearly", "keep_yearly"),
            ):
                if retention.get(key):
                    prune_cmd += [flag, str(retention[key])]

            log.info("running: %s", " ".join(prune_cmd))
            if dry_run:
                log.info("[dry-run] would prune with: %s", " ".join(prune_cmd))
            else:
                run_borg(prune_cmd, env)

            duration = format_duration(time.monotonic() - start)
            log.info("backup complete: %s::%s (duration: %s)", repo, archive_name, duration)
            finish("success", archive_name=resolved_archive_name, stats=stats)
            return True
        except subprocess.CalledProcessError as exc:
            duration = format_duration(time.monotonic() - start)
            log.error("backup failed after %s: %s", duration, exc)
            finish("failure", error_message=str(exc))
            return False
        finally:
            cleanup_dump_dirs(dump_dirs, dry_run)


def run_check(config):
    """Run `borg check` against this host's own repo. Read-only integrity
    verification -- never --repair, which is a deliberate manual admin
    action, not something this tool automates."""
    wall_start = datetime.now(timezone.utc)
    identifier = resolve_identifier(config)
    encryption_cfg = config.get("encryption") or {}
    passphrase = encryption_cfg.get("passphrase") or ""
    env = build_env(passphrase, SSH_KEY_PATH)
    repo = repo_url(config, identifier)

    db_conn = _db_safe(db_connect, config)
    repo_id = _db_safe(db_get_repo_id, db_conn, config, identifier) if db_conn else None

    def finish(status, error_message=None):
        if db_conn and repo_id:
            _db_safe(db_record_check_run, db_conn, repo_id, status, wall_start, error_message)
        if db_conn:
            db_conn.close()

    log.info("checking repo integrity: %s", repo)
    try:
        run_borg([BORG_CMD, "check", repo], env)
    except subprocess.CalledProcessError as exc:
        log.error("borg check failed for %s: %s", repo, exc)
        finish("failure", error_message=str(exc))
        return False
    log.info("borg check passed: %s", repo)
    finish("success")
    return True


def get_passphrase(config, args):
    if args.passphrase_file:
        with open(args.passphrase_file, "r") as f:
            return f.read().strip()
    configured = (config.get("encryption") or {}).get("passphrase")
    if configured:
        return configured
    if os.environ.get("BORG_PASSPHRASE"):
        return os.environ["BORG_PASSPHRASE"]
    if sys.stdin.isatty():
        return getpass.getpass("Borg repository passphrase: ")
    log.error(
        "no passphrase available: pass --passphrase-file, set $BORG_PASSPHRASE, "
        "or run this interactively"
    )
    sys.exit(1)


def resolve_repo_and_env(config, args):
    """Shared repo/env resolution for the admin-driven commands
    (list-archives, restore). Every piece is override-able from the
    command line because the whole point of these commands is to work
    against a repo that this host's own config.yml may know nothing
    about -- e.g. restoring onto a freshly reimaged replacement host, or
    running from a jump host with the admin recovery key."""
    identifier = args.host or resolve_identifier(config)
    ssh_user = args.ssh_user or config.get("ssh_borgbackup_server_username") or DEFAULT_SSH_USER
    server = args.server or config.get("borgbackup_server")
    location = args.location or config.get("borgbackup_server_backup_location") or DEFAULT_BACKUP_LOCATION
    repo = build_repo_url(ssh_user, server, location, identifier)

    passphrase = get_passphrase(config, args)
    ssh_key_path = args.ssh_key or SSH_KEY_PATH
    env = build_env(passphrase, ssh_key_path)
    return identifier, repo, env


def cmd_configure(args):
    if not os.path.exists(CONFIGURE_SCRIPT):
        log.error(
            "configure script not found at %s (this command only works "
            "from a Debian package install; use install/install.sh directly "
            "from a git checkout instead)",
            CONFIGURE_SCRIPT,
        )
        sys.exit(1)
    exec_args = [CONFIGURE_SCRIPT, "--skip-packages", "--skip-binary"]
    if args.passphrase_file:
        exec_args += ["--passphrase-file", args.passphrase_file]
    os.execv(CONFIGURE_SCRIPT, exec_args)


def cmd_list_archives(args, config):
    _identifier, repo, env = resolve_repo_and_env(config, args)
    ok = run_borg_interactive([BORG_CMD, "list", repo], env)
    sys.exit(0 if ok else 1)


def cmd_restore(args, config):
    _identifier, repo, env = resolve_repo_and_env(config, args)
    os.makedirs(args.target, exist_ok=True)

    cmd = [BORG_CMD, "extract"]
    if args.dry_run:
        cmd.append("--dry-run")
        cmd.append("--list")
    cmd.append(f"{repo}::{args.archive}")
    cmd.extend(args.paths)

    log.info("extracting %s::%s into %s", repo, args.archive, args.target)
    ok = run_borg_interactive(cmd, env, cwd=args.target)
    sys.exit(0 if ok else 1)


def add_repo_override_args(parser):
    parser.add_argument("--host", help="Host identifier whose repo to use (default: this host's own identifier)")
    parser.add_argument("--server", help="Override borgbackup_server")
    parser.add_argument("--ssh-user", help="Override ssh_borgbackup_server_username")
    parser.add_argument("--location", help="Override borgbackup_server_backup_location")
    parser.add_argument(
        "--ssh-key",
        help="SSH private key to use (default: this host's dedicated key; "
             "point this at the admin recovery key when restoring onto a "
             "replacement host)",
    )
    parser.add_argument(
        "--passphrase-file",
        help="File containing the repo passphrase (default: config.yml, "
             "then $BORG_PASSPHRASE, then an interactive prompt)",
    )


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--config", default=DEFAULT_CONFIG_PATH)

    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_backup = sub.add_parser("backup", parents=[common], help="Run a backup per config.yml (default)")
    p_backup.add_argument("--dry-run", action="store_true")
    p_backup.add_argument(
        "--once", action="store_true",
        help="run a single backup even if schedule.mode is continuous",
    )

    sub.add_parser("check", parents=[common], help="Verify this host's repo integrity (borg check)")

    p_list = sub.add_parser("list-archives", parents=[common], help="List archives in a repo")
    add_repo_override_args(p_list)

    p_restore = sub.add_parser("restore", parents=[common], help="Extract an archive into a target directory")
    add_repo_override_args(p_restore)
    p_restore.add_argument("--archive", required=True, help="Archive name, e.g. from list-archives")
    p_restore.add_argument("--target", required=True, help="Directory to extract into (created if missing)")
    p_restore.add_argument("--paths", nargs="*", default=[], help="Restrict extraction to these paths")
    p_restore.add_argument("--dry-run", action="store_true", help="List what would be extracted without writing anything")

    p_configure = sub.add_parser(
        "configure",
        aliases=["setup"],
        help="Interactively (re-)configure this host (Debian package installs only); "
             "also available as 'setup'",
    )
    p_configure.add_argument(
        "--passphrase-file",
        help="Use the passphrase in FILE instead of auto-generating one (first-time setup only)",
    )

    return parser


KNOWN_COMMANDS = {"backup", "check", "list-archives", "restore", "configure", "setup", "-h", "--help"}


def normalize_argv(argv):
    """A bare invocation (no subcommand, or one starting with a flag) is
    still accepted and treated as `backup`, for compatibility with older
    invocations and the systemd units that predate subcommands."""
    if not argv or argv[0] not in KNOWN_COMMANDS:
        return ["backup"] + list(argv)
    return list(argv)


def main():
    argv = normalize_argv(sys.argv[1:])

    parser = build_parser()
    args = parser.parse_args(argv)

    setup_logging()

    if args.command in ("configure", "setup"):
        cmd_configure(args)
        return

    if shutil.which(BORG_CMD) is None:
        log.error("%s command not found; is the borgbackup package installed?", BORG_CMD)
        sys.exit(1)

    if args.command == "list-archives":
        config = load_config(args.config, required=False)
        cmd_list_archives(args, config)
        return

    if args.command == "restore":
        config = load_config(args.config, required=False)
        cmd_restore(args, config)
        return

    if args.command == "check":
        config = load_config(args.config, required=True)
        sys.exit(0 if run_check(config) else 1)

    config = load_config(args.config, required=True)
    schedule = config.get("schedule") or {}
    continuous = schedule.get("mode") == "continuous" and not args.once

    if not continuous:
        ok = run_backup(config, args.dry_run)
        sys.exit(0 if ok else 1)

    log.info("starting continuous backup loop")
    while True:
        ok = run_backup(config, args.dry_run)
        if not ok:
            log.error("backup run failed; retrying after short delay")
            time.sleep(30)
        if args.dry_run:
            # Avoid spinning forever when just testing.
            break


if __name__ == "__main__":
    main()
